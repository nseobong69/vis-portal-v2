---
// Real route at /about — was a full-screen JS modal in the old app
// (showAboutPage()), pushed to /about via history.pushState but never
// server-rendered there. Per Phase 0's Section 5 recommendation, this
// is now a real server-rendered page instead.
import PublicLayout from '../layouts/PublicLayout.astro';
import InfoRow from '../components/InfoRow.astro';

const values = [
  { icon: '💡', title: 'Learning with Purpose',
    body: 'At Victorious International Schools, a world-class education cultivates critical thinking, creative problem-solving, and the essential qualities of global citizenship — rooted in the values of our community.' },
  { icon: '🕊️', title: 'Peace through Understanding',
    body: 'We believe knowledge is most powerful when paired with humility. Our students learn to listen deeply, think critically, and lead with the wisdom that comes from diverse perspectives.' },
  { icon: '💪', title: 'Strength through Difference',
    body: 'Diversity is not a challenge to manage — it is a strength to celebrate. We build a school community where every background, ability and viewpoint is welcomed and respected.' },
  { icon: '🤝', title: 'Empathy in Action',
    body: 'Compassion is not a feeling alone — it is a choice we make every day. We nurture students who see the needs around them and respond with genuine care, building communities stronger than any individual.' },
];
---
<PublicLayout title="About" description="About Victorious International Schools.">
  <div class="max-w-[680px] mx-auto px-5 py-12">
    <h1 class="font-heading font-extrabold text-3xl text-brand-brown-dark mb-3">
      About Victorious International Schools
    </h1>
    <p class="text-brand-brown-light leading-relaxed mb-8">
      We are a co-educational school located in Cross River State, Nigeria, nurturing
      learners from Crèche through Senior Secondary School. Our programme builds
      character, wisdom and academic excellence within a safe, values-centred environment.
    </p>

    <h2 class="font-heading font-bold text-xs uppercase tracking-wide text-brand-brown mb-2">
      Our Core Values
    </h2>
    <div class="border border-brand-cream-dark rounded-lg px-4">
      {values.map((v) => <InfoRow icon={v.icon} title={v.title} body={v.body} />)}
    </div>

    <div class="mt-6 bg-brand-cream rounded-lg px-5 py-4 flex flex-wrap gap-4 text-sm text-brand-brown">
      <span>📍 Okpok-Ikpa Okoyong, Odukpani LGA, Cross River State, Nigeria</span>
    </div>

    <div class="flex gap-3 mt-8 flex-wrap">
      <a href="/admissions" class="flex-1 min-w-[180px] text-center bg-brand-brown text-white font-semibold py-3.5 rounded-md hover:bg-brand-brown-dark">
        Admissions →
      </a>
      <a href="/" class="px-5 py-3.5 rounded-md border border-brand-cream-dark text-brand-brown-light font-medium hover:bg-brand-cream">
        Back home
      </a>
    </div>
  </div>
</PublicLayout>
