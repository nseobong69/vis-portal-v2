# VIS Portal — environment variables
# Copy this file to `.env` in the vis-portal-v2/ project root (same folder
# as package.json) and fill in real values. Astro loads .env automatically
# in dev (`npm run dev`) and at build time (`npm run build`) — nothing
# else to wire up code-side, these are read directly via import.meta.env
# throughout src/lib and src/pages/api.
#
# PUBLIC_-prefixed vars are the only ones exposed to browser JS. Never
# prefix a secret key with PUBLIC_.

# --- Supabase (required — nothing in the app works without these) ---
# Dashboard → Project Settings → API
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Dashboard → Project Settings → API → service_role key.
# SECRET — server-side only. Used by exactly one route in this codebase:
# api/admin/accounts/create.ts (creating other users' auth accounts is a
# privileged action the anon-key/RLS pattern can't do). Do not reuse this
# key anywhere else, and do not commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Paystack (fee payments) ---
# Dashboard → Settings → API Keys & Webhooks. Use the TEST secret key
# until you're ready to take real payments.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx

# --- Cloudinary (CBT proctoring photos + ID card photos) ---
# Dashboard home page shows Cloud Name, API Key, API Secret directly.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- EmailJS (OTP emails + admin Email Center) ---
# Dashboard → Email Services (service id), Email Templates (template id),
# Account → API Keys (public + private key).
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=your-public-key
EMAILJS_PRIVATE_KEY=your-private-key
