---
// A real, distinct "not authorized" response — per Section 3, this must
// be returned in place of the requested data, not a silent redirect that
// could be mistaken for success.
Astro.response.status = 403;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Not authorized · VIS Portal</title>
</head>
<body>
  <h1>403 — Not authorized</h1>
  <p>Your account doesn't have access to this page.</p>
  <a href="/">Return to homepage</a>
</body>
</html>
