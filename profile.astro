---
// Ports the core fields of renderProfile() for the `student` role (this
// function is shared with teacher/subject_teacher in the old app — those
// get their own route when Staff/Teacher Portal is migrated, not this
// one). Email-change OTP verification is now real (send-otp.ts /
// verify-otp.ts / update.ts's confirmed-OTP gate) — the one piece still
// not wired up is actually delivering the email (needs EMAILJS_* env
// vars at deploy time, see send-otp.ts). Still NOT ported: live camera
// photo capture (openCameraForProfile, face-api.js) — a Cloudinary/
// face-api dependency out of scope for this pass, same category as the
// Academics file-upload TODO.
import StudentLayout from '../../layouts/StudentLayout.astro';
import Card from '../../components/ui/Card';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';

const auth = await checkAuth(Astro.cookies, ['student']);
if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

const supabase = createServerSupabase(Astro.cookies);
const { data: student } = await supabase
  .from('students')
  .select('full_name, gender, email, phone, address, admission_number')
  .eq('id', auth.userId)
  .single();

const saved = Astro.url.searchParams.get('saved') === '1';
const emailUnverified = Astro.url.searchParams.get('email_unverified') === '1';
---
<StudentLayout title="My Profile" activePath="/student/profile">
  <Card title="Update Profile" className="max-w-[520px]">
    {saved && !emailUnverified && <p class="text-success-700 text-sm mb-3">✅ Profile updated!</p>}
    {saved && emailUnverified && (
      <p class="text-warning-700 text-sm mb-3">
        ✅ Other changes saved. Email was NOT changed — verify the new address first (see below).
      </p>
    )}
    <div class="text-xs text-brand-brown-light mb-3">Admission: {student?.admission_number || '—'}</div>
    <form method="POST" action="/api/student/profile/update" id="pf-form" class="flex flex-col gap-3">
      <div>
        <label class="block text-xs font-semibold text-brand-brown-light mb-1">Full Name</label>
        <input name="full_name" class="w-full border border-brand-cream-dark rounded-md px-3 py-2 text-sm" value={student?.full_name || ''} />
      </div>
      <div>
        <label class="block text-xs font-semibold text-brand-brown-light mb-1">Gender</label>
        <select name="gender" class="w-full border border-brand-cream-dark rounded-md px-3 py-2 text-sm">
          <option value="">Select</option>
          <option value="Male" selected={student?.gender === 'Male'}>Male</option>
          <option value="Female" selected={student?.gender === 'Female'}>Female</option>
        </select>
      </div>
      <div>
        <label class="block text-xs font-semibold text-brand-brown-light mb-1">Email <span class="font-normal">(must be verified to change)</span></label>
        <div class="flex gap-2 items-center">
          <input id="pf-email" name="email" type="email" class="flex-1 border border-brand-cream-dark rounded-md px-3 py-2 text-sm" value={student?.email || ''} />
          <button type="button" id="pf-verify-btn" class="px-3 py-2 rounded-md border border-brand-cream-dark text-sm font-medium whitespace-nowrap">Verify</button>
        </div>
        <div id="pf-otp-wrap" class="hidden mt-2 flex gap-2 items-center">
          <input id="pf-otp-inp" maxlength="6" placeholder="Enter 6-digit code" class="flex-1 border border-brand-cream-dark rounded-md px-3 py-2 text-sm tracking-widest text-center" />
          <button type="button" id="pf-confirm-btn" class="px-3 py-2 rounded-md bg-success-700 text-white text-sm font-medium whitespace-nowrap">Confirm</button>
        </div>
        <p id="pf-email-msg" class="text-xs mt-1"></p>
      </div>
      <div>
        <label class="block text-xs font-semibold text-brand-brown-light mb-1">Phone</label>
        <input name="phone" type="tel" class="w-full border border-brand-cream-dark rounded-md px-3 py-2 text-sm" value={student?.phone || ''} />
      </div>
      <div>
        <label class="block text-xs font-semibold text-brand-brown-light mb-1">Address</label>
        <input name="address" class="w-full border border-brand-cream-dark rounded-md px-3 py-2 text-sm" value={student?.address || ''} />
      </div>
      <div>
        <label class="block text-xs font-semibold text-brand-brown-light mb-1">New Password (leave blank to keep current)</label>
        <input name="password" type="password" class="w-full border border-brand-cream-dark rounded-md px-3 py-2 text-sm" placeholder="Min 6 characters" />
      </div>
      <button type="submit" class="px-4 py-2 rounded-md bg-brand-brown text-white text-sm font-medium">Save Profile</button>
    </form>
  </Card>
  <!-- TODO: live camera profile photo capture (openCameraForProfile) — see this file's header comment. -->

  <script>
    // Ports sendProfileEmailOTP()/confirmProfileEmailOTP() as plain fetch
    // calls — no React island needed for a two-button flow on an
    // otherwise-static page. The actual email column only changes once
    // /api/student/profile/update sees a confirmed OTP row matching the
    // exact email in the form (see that file); this script just drives
    // the send/confirm round trip and surfaces its own errors inline.
    const verifyBtn = document.getElementById('pf-verify-btn');
    const confirmBtn = document.getElementById('pf-confirm-btn');
    const otpWrap = document.getElementById('pf-otp-wrap');
    const msg = document.getElementById('pf-email-msg');
    const emailInput = document.getElementById('pf-email') as HTMLInputElement | null;
    const otpInput = document.getElementById('pf-otp-inp') as HTMLInputElement | null;

    function setMsg(text: string, tone: 'error' | 'success') {
      if (!msg) return;
      msg.textContent = text;
      msg.className = `text-xs mt-1 ${tone === 'error' ? 'text-danger-700' : 'text-success-700'}`;
    }

    verifyBtn?.addEventListener('click', async () => {
      const email = emailInput?.value.trim() || '';
      setMsg('Sending code…', 'success');
      try {
        const res = await fetch('/api/student/profile/send-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        const json = await res.json();
        if (!res.ok) throw new Error(json.error || 'Could not send verification code.');
        otpWrap?.classList.remove('hidden');
        setMsg('Code sent — enter it below (expires in 6 hours).', 'success');
      } catch (e) {
        setMsg(e instanceof Error ? e.message : 'Could not send verification code.', 'error');
      }
    });

    confirmBtn?.addEventListener('click', async () => {
      const email = emailInput?.value.trim() || '';
      const code = otpInput?.value.trim() || '';
      try {
        const res = await fetch('/api/student/profile/verify-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, code }),
        });
        const json = await res.json();
        if (!res.ok) throw new Error(json.error || 'Incorrect code.');
        setMsg('✅ Email verified — click Save Profile to apply it.', 'success');
        otpWrap?.classList.add('hidden');
      } catch (e) {
        setMsg(e instanceof Error ? e.message : 'Incorrect code.', 'error');
      }
    });
  </script>
</StudentLayout>
