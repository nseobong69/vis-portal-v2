---
// The two missing buttons from the old app's Account Creation screen
// (renderACExisting(), index.html ~L18792-18832) — "New Student/Staff
// Accounts" already exist in create.astro; "Existing Student/Staff
// Accounts" never got built. Kept as its OWN page rather than folded
// into create.astro since I only have a screenshot of that file, not
// its full current source — safer than guessing at a merge. Add two
// links to it from create.astro's button row:
//   <a href="/admin/accounts/existing?type=student">Existing Student Accounts</a>
//   <a href="/admin/accounts/existing?type=staff">Existing Staff Accounts</a>
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ExistingAccountsPanel from '../../../components/admin/ExistingAccountsPanel';
import { checkAuth } from '../../../lib/auth';

const auth = await checkAuth(Astro.cookies, ['super_admin', 'admin', 'proprietor', 'head_teacher', 'principal']);
if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

const type = Astro.url.searchParams.get('type') === 'staff' ? 'staff' : 'student';
// Mirrors renderACExisting()'s own staff-tab gate (index.html ~L18796).
if (type === 'staff' && !['super_admin', 'admin'].includes(auth.role)) {
  return new Response('Only Super Admin and Admin can view existing staff accounts.', { status: 403 });
}
---
<AdminLayout title="Existing Accounts" activePath="/admin/accounts/existing" role={auth.role}>
  <div class="flex flex-col gap-4">
    <div class="flex items-center gap-2">
      <a href="/admin/accounts/existing?type=student" class:list={['px-3 py-1.5 rounded-md text-sm', type === 'student' ? 'bg-brand-brown text-white' : 'border border-brand-cream-dark text-brand-brown-dark']}>
        👥 Existing Student Accounts
      </a>
      {['super_admin', 'admin'].includes(auth.role) && (
        <a href="/admin/accounts/existing?type=staff" class:list={['px-3 py-1.5 rounded-md text-sm', type === 'staff' ? 'bg-brand-brown text-white' : 'border border-brand-cream-dark text-brand-brown-dark']}>
          🪪 Existing Staff Accounts
        </a>
      )}
      <a href="/admin/accounts/create" class="ml-auto text-sm text-brand-brown-light hover:underline">← Back to Account Creation</a>
    </div>

    <div class="bg-white rounded-lg border border-brand-cream-dark shadow-sm p-5">
      <ExistingAccountsPanel client:load type={type} />
    </div>
  </div>
</AdminLayout>
