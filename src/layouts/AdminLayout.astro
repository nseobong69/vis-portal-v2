---
// Shell for the Admin-tier screens (super_admin / admin / proprietor —
// Phase 0's "near-identical menus, ~34 screens each" role group; see
// Combined_Project_Phase_Outputs.md Section 3). Same pattern as
// ParentLayout/StudentLayout — presentation only, the real per-route
// auth check happens in each page's own frontmatter before this shell
// is reached.
//
// NOTE: this nav is intentionally a subset of the ~34 admin screens
// listed in Phase 0's table, not the full set — add items here as each
// screen gets its own real port (same incremental approach Phase
// 3/3b/3c/3d used for Public/Parent/Student). `showSettings` gates
// School Settings to super_admin only, matching Phase 0 finding (only
// super_admin gets Settings; admin/proprietor do not).
//
// CHANGED from the previous version: the "Attendance" link now branches
// by role — teachers go to the day-by-day marking screen
// (/staff/attendance), admin-tier roles go to the read-only oversight
// screen (/admin/attendance). "Finance" now points at the fuller Finance
// Records screen (/admin/finance-records: ledger/summary/expenditure);
// Fee Configuration is still reachable from a link on that page.
//
// ADDED: Fee Receipts (per-student invoice/receipt PDFs — a separate
// old-app screen from Finance Records, index.html's renderFeeReceipts()),
// Scholarship (renderScholarship()), and ID Cards (id-cards.astro — file
// already exists in the repo, status of its port unverified). All three
// gated the same way their old-app FINANCE_ROLES/allowed lists require
// where known; ID Cards has no confirmed role restriction from the old
// app yet, so it's shown to the same roles as the rest of this nav for
// now — revisit if that old-app function ever gets checked directly.
import '../styles/global.css';

interface Props {
  title: string;
  activePath: string;
  role?: string;
}
const { title, activePath, role = '' } = Astro.props;
const showSettings = role === 'super_admin';
// Finance is restricted to Admin, Bursar and School Director in the old
// app (index.html line ~13567) — head_teacher/principal don't get it.
// Fee Receipts and Scholarship use the same allowed-role list in the old
// app (renderFeeReceipts()/renderScholarship() both check
// ['super_admin','admin','proprietor','bursar','cashier'] — 'cashier'
// isn't a role this app's auth system has yet, so it's omitted here).
const financeRoles = ['super_admin', 'admin', 'bursar', 'proprietor'];
const showFinance = financeRoles.includes(role);
const attendanceHref = role === 'teacher' ? '/staff/attendance' : '/admin/attendance';

const navItems = [
  { href: '/admin/dashboard', label: 'Dashboard' },
  { href: '/admin/students', label: 'Students' },
  { href: '/admin/staff', label: 'Staff' },
  { href: '/admin/classes', label: 'Classes' },
  { href: '/admin/results', label: 'Results' },
  { href: '/admin/combined-pdf', label: 'Combined PDF' },
  { href: attendanceHref, label: 'Attendance' },
  ...(showFinance ? [
    { href: '/admin/finance-records', label: 'Finance' },
    { href: '/admin/fee-receipts', label: 'Fee Receipts' },
    { href: '/admin/payroll', label: 'Payroll' },
  ] : []),
  { href: '/admin/cbt', label: 'CBT Exams' },
  ...(showFinance ? [{ href: '/admin/scholarship', label: 'Scholarship' }] : []),
  { href: '/admin/id-cards', label: 'ID Cards' },
  { href: '/admin/announcements', label: 'Announce' },
  ...(showSettings ? [{ href: '/admin/settings', label: 'Settings' }] : []),
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} · VIS Portal</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body class="min-h-screen bg-brand-cream font-body text-body">
  <nav class="bg-shell-obsidian text-shell-text sticky top-0 z-40 border-b border-white/10">
    <div class="max-w-[1400px] mx-auto px-5 h-16 flex items-center justify-between gap-4 overflow-x-auto">
      <div class="flex items-center gap-2 shrink-0">
        <div class="w-9 h-9 rounded-md bg-gradient-to-br from-brand-gold to-brand-gold-dark shadow-gold"></div>
        <span class="font-heading font-bold text-brand-gold text-[15px]">VIS Admin</span>
      </div>
      <div class="flex items-center gap-1 text-xs shrink-0">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'px-3 py-1.5 rounded-md transition-colors whitespace-nowrap',
              activePath === item.href
                ? 'bg-white/10 text-brand-gold font-semibold'
                : 'text-shell-muted hover:text-shell-text',
            ]}
          >
            {item.label}
          </a>
        ))}
      </div>
      {role && (
        <span class="shrink-0 text-[10px] font-bold tracking-wide uppercase text-brand-gold bg-white/10 px-2.5 py-1 rounded-full">
          {role.replace('_', ' ')}
        </span>
      )}
    </div>
  </nav>
  <main class="max-w-[1400px] mx-auto px-5 py-8">
    <slot />
  </main>
</body>
</html>
