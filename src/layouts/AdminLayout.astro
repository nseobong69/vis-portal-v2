---
// Admin Portal shell — the admin-tier slice of MENUS (Section 4 Phase 4
// grouping 1: super_admin, admin, proprietor, head_teacher, principal).
// Wraps pages — does NOT replace the real per-route auth check, which
// happens in each page's own frontmatter before this layout is even
// reached (Section 3). Deliberately reuses the StaffLayout/StudentLayout/
// ParentLayout visual shell rather than inventing a new one.
//
// `superAdminOnly` items are shown to every admin-tier visitor (so the
// nav doesn't silently look incomplete) but the routes themselves still
// 403 a non-super_admin — matching the pattern the old app used for
// School Settings (Section 2.2).
//
// All styling comes from tokens.css (via global.css) + the Tailwind
// config that maps to it — no hardcoded hex values or duplicate :root
// blocks here. Keep it that way; a second :root in this file is what
// caused the color-drift bug previously.
import '../styles/global.css';

interface Props {
  title: string;
  activePath: string;
  role?: string;
}
const { title, activePath, role } = Astro.props;

const navGroups = [
  {
    label: 'Overview',
    items: [{ href: '/admin/dashboard', label: 'Dashboard' }],
  },
  {
    label: 'Academics',
    items: [
      { href: '/admin/class-hub', label: 'Class Hub' },
      { href: '/admin/students', label: 'Students/Pupils' },
      { href: '/admin/classes', label: 'Classes' },
      { href: '/admin/subjects', label: 'Subjects' },
      { href: '/admin/staff', label: 'Staff & Teachers' },
      { href: '/admin/fix-name-order', label: 'Fix Name Order' },
      { href: '/admin/assignments', label: 'Assignments' },
      { href: '/admin/subject-registration', label: 'Subject Registration' },
      { href: '/admin/academics', label: 'Academics (Notes/Videos)' },
    ],
  },
  {
    label: 'Results & Tests',
    items: [
      { href: '/admin/results', label: 'Results Entry' },
      { href: '/admin/monitor-scores', label: 'Monitor Scores' },
      { href: '/admin/result-pins', label: 'Result PINs' },
      { href: '/admin/cbt', label: 'CBT Module' },
      { href: '/admin/aptitude-tests', label: 'Aptitude Tests' },
    ],
  },
  {
    label: 'Attendance & Clearance',
    items: [
      { href: '/admin/attendance', label: 'Attendance' },
      { href: '/admin/clearance', label: 'Student Clearance' },
    ],
  },
  {
    label: 'Finance',
    items: [
      { href: '/admin/fees', label: 'Fee Configuration' },
      { href: '/admin/fees/payments', label: 'Payment Tracking' },
      { href: '/admin/payroll', label: 'Staff Payroll' },
    ],
  },
  {
    label: 'Admissions',
    items: [
      { href: '/admin/admissions', label: 'Admissions' },
      { href: '/admin/scholarship', label: 'Scholarship' },
    ],
  },
  {
    label: 'Communication',
    items: [
      { href: '/admin/announcements', label: 'Announcements' },
      { href: '/admin/public-posts', label: 'Public Posts (CMS)' },
      { href: '/admin/email-center', label: 'Email Center' },
    ],
  },
  {
    label: 'People & Access',
    items: [
      { href: '/admin/parents', label: 'Parents' },
      { href: '/admin/accounts/create', label: 'Account Creation' },
      { href: '/admin/signup-profiles', label: 'Sign Up Profiles' },
      { href: '/admin/reception', label: 'Reception' },
    ],
  },
  {
    label: 'Operations',
    items: [
      { href: '/admin/id-cards', label: 'ID Cards' },
      { href: '/admin/calendar', label: 'School Calendar' },
      { href: '/admin/analytics', label: 'Analytics' },
      { href: '/admin/settings', label: 'School Settings', superAdminOnly: true },
    ],
  },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} · VIS Portal Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body class="min-h-screen bg-brand-cream font-body text-body">

  <!-- Mobile drawer backdrop -->
  <div
    id="mobile-backdrop"
    class="fixed inset-0 z-40 hidden bg-black/50 lg:hidden"
  ></div>

  <!-- Mobile drawer -->
  <aside
    id="mobile-drawer"
    class="fixed inset-y-0 left-0 z-50 flex w-64 -translate-x-full flex-col overflow-y-auto bg-shell-obsidian text-shell-text transition-transform duration-200 lg:hidden"
  >
    <div class="flex h-16 shrink-0 items-center gap-2 border-b border-white/10 px-5">
      <div class="w-9 h-9 rounded-md bg-gradient-to-br from-brand-gold to-brand-gold-dark shadow-gold"></div>
      <span class="font-heading font-bold text-brand-gold text-[15px]">VIS Admin</span>
      <button
        id="close-drawer"
        aria-label="Close menu"
        class="ml-auto border-none bg-transparent text-[22px] leading-none text-shell-muted"
      >
        &times;
      </button>
    </div>
    <nav class="flex-1 space-y-5 px-3 py-4">
      {navGroups.map((group) => (
        <div>
          <p class="px-2 mb-1 text-[10px] font-heading font-bold uppercase tracking-wider text-shell-muted">
            {group.label}
          </p>
          <div class="space-y-0.5">
            {group.items.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'flex items-center justify-between px-2.5 py-1.5 rounded-md text-xs transition-colors',
                  activePath === item.href
                    ? 'bg-white/10 text-brand-gold font-semibold'
                    : 'text-shell-muted hover:text-shell-text',
                ]}
              >
                <span>{item.label}</span>
                {item.superAdminOnly && (
                  <span class="text-[9px] px-1 py-0.5 rounded bg-brand-gold/20 text-brand-gold">SA</span>
                )}
              </a>
            ))}
          </div>
        </div>
      ))}
    </nav>
  </aside>

  <div class="flex">
    <!-- Desktop sidebar -->
    <aside class="hidden lg:flex flex-col w-64 shrink-0 h-screen sticky top-0 bg-shell-obsidian text-shell-text border-r border-white/10 overflow-y-auto">
      <div class="flex items-center gap-2 px-5 h-16 shrink-0 border-b border-white/10">
        <div class="w-9 h-9 rounded-md bg-gradient-to-br from-brand-gold to-brand-gold-dark shadow-gold"></div>
        <span class="font-heading font-bold text-brand-gold text-[15px]">VIS Admin</span>
      </div>
      <nav class="py-4 px-3 space-y-5">
        {navGroups.map((group) => (
          <div>
            <p class="px-2 mb-1 text-[10px] font-heading font-bold uppercase tracking-wider text-shell-muted">
              {group.label}
            </p>
            <div class="space-y-0.5">
              {group.items.map((item) => (
                <a
                  href={item.href}
                  class:list={[
                    'flex items-center justify-between px-2.5 py-1.5 rounded-md text-xs transition-colors',
                    activePath === item.href
                      ? 'bg-white/10 text-brand-gold font-semibold'
                      : 'text-shell-muted hover:text-shell-text',
                  ]}
                >
                  <span>{item.label}</span>
                  {item.superAdminOnly && (
                    <span class="text-[9px] px-1 py-0.5 rounded bg-brand-gold/20 text-brand-gold">SA</span>
                  )}
                </a>
              ))}
            </div>
          </div>
        ))}
      </nav>
    </aside>

    <div class="flex-1 min-w-0">
      <!-- Mobile top bar -->
      <nav class="lg:hidden bg-shell-obsidian text-shell-text sticky top-0 z-30 border-b border-white/10">
        <div class="px-5 h-16 flex items-center gap-3">
          <button
            id="open-drawer"
            aria-label="Open menu"
            class="-ml-1 flex flex-col gap-[5px] p-1"
          >
            <span class="block h-0.5 w-5 rounded bg-shell-text"></span>
            <span class="block h-0.5 w-5 rounded bg-shell-text"></span>
            <span class="block h-0.5 w-5 rounded bg-shell-text"></span>
          </button>
          <div class="w-9 h-9 rounded-md bg-gradient-to-br from-brand-gold to-brand-gold-dark shadow-gold"></div>
          <span class="font-heading font-bold text-brand-gold text-[15px]">VIS Admin</span>
          {role && (
            <span class="ml-auto text-[10px] px-2 py-0.5 rounded-full bg-brand-gold/20 text-brand-gold font-heading font-bold uppercase tracking-wide">
              {role.replace('_', ' ')}
            </span>
          )}
        </div>
      </nav>
      <main class="max-w-[1400px] mx-auto px-5 py-8">
        <slot />
      </main>
    </div>
  </div>

  <script>
    const openBtn  = document.getElementById('open-drawer');
    const closeBtn = document.getElementById('close-drawer');
    const drawer   = document.getElementById('mobile-drawer');
    const backdrop = document.getElementById('mobile-backdrop');

    function openDrawer() {
      drawer?.classList.remove('-translate-x-full');
      backdrop?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
    function closeDrawer() {
      drawer?.classList.add('-translate-x-full');
      backdrop?.classList.add('hidden');
      document.body.style.overflow = '';
    }

    openBtn?.addEventListener('click', openDrawer);
    closeBtn?.addEventListener('click', closeDrawer);
    backdrop?.addEventListener('click', closeDrawer);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDrawer(); });
  </script>
</body>
</html>
