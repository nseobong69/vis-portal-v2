---
import '../styles/global.css';

interface Props {
  title: string;
  activePath: string;
  role?: string;
}
const { title, activePath, role } = Astro.props;

const navGroups = [
  {
    label: 'Overview',
    items: [{ href: '/admin/dashboard', label: 'Dashboard' }],
  },
  {
    label: 'Academics',
    items: [
      { href: '/admin/class-hub', label: 'Class Hub' },
      { href: '/admin/students', label: 'Students/Pupils' },
      { href: '/admin/classes', label: 'Classes' },
      { href: '/admin/subjects', label: 'Subjects' },
      { href: '/admin/staff', label: 'Staff & Teachers' },
      { href: '/admin/fix-name-order', label: 'Fix Name Order' },
      { href: '/admin/assignments', label: 'Assignments' },
      { href: '/admin/subject-registration', label: 'Subject Registration' },
      { href: '/admin/academics', label: 'Academics (Notes/Videos)' },
    ],
  },
  {
    label: 'Results & Tests',
    items: [
      { href: '/admin/results', label: 'Results Entry' },
      { href: '/admin/monitor-scores', label: 'Monitor Scores' },
      { href: '/admin/result-pins', label: 'Result PINs' },
      { href: '/admin/cbt', label: 'CBT Module' },
      { href: '/admin/aptitude-tests', label: 'Aptitude Tests' },
    ],
  },
  {
    label: 'Attendance & Clearance',
    items: [
      { href: '/admin/attendance', label: 'Attendance' },
      { href: '/admin/clearance', label: 'Student Clearance' },
    ],
  },
  {
    label: 'Finance',
    items: [
      { href: '/admin/fees', label: 'Fee Configuration' },
      { href: '/admin/fees/payments', label: 'Payment Tracking' },
      { href: '/admin/payroll', label: 'Staff Payroll' },
    ],
  },
  {
    label: 'Admissions',
    items: [
      { href: '/admin/admissions', label: 'Admissions' },
      { href: '/admin/scholarship', label: 'Scholarship' },
    ],
  },
  {
    label: 'Communication',
    items: [
      { href: '/admin/announcements', label: 'Announcements' },
      { href: '/admin/public-posts', label: 'Public Posts (CMS)' },
      { href: '/admin/email-center', label: 'Email Center' },
    ],
  },
  {
    label: 'People & Access',
    items: [
      { href: '/admin/parents', label: 'Parents' },
      { href: '/admin/accounts/create', label: 'Account Creation' },
      { href: '/admin/signup-profiles', label: 'Sign Up Profiles' },
      { href: '/admin/reception', label: 'Reception' },
    ],
  },
  {
    label: 'Operations',
    items: [
      { href: '/admin/id-cards', label: 'ID Cards' },
      { href: '/admin/calendar', label: 'School Calendar' },
      { href: '/admin/analytics', label: 'Analytics' },
      { href: '/admin/settings', label: 'School Settings', superAdminOnly: true },
    ],
  },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} · VIS Portal Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --brand-cream:     #FAF7F2;
      --brand-gold:      #C9A84C;
      --brand-gold-dark: #A07830;
      --shell-obsidian:  #0F1117;
      --shell-text:      #F0EDE8;
      --shell-muted:     #8A8880;
      --text-body:       #1A1A1A;
      --font-body:       'Outfit', sans-serif;
      --font-heading:    'Syne', sans-serif;
      --shadow-gold:     0 2px 12px rgba(201,168,76,0.35);
    }
    #mobile-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.5);
      z-index: 40;
    }
    #mobile-backdrop.open { display: block; }
    #mobile-drawer {
      position: fixed;
      top: 0; left: 0; bottom: 0;
      width: 260px;
      background: var(--shell-obsidian);
      color: var(--shell-text);
      z-index: 50;
      transform: translateX(-100%);
      transition: transform 0.25s ease;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
    }
    #mobile-drawer.open { transform: translateX(0); }
  </style>
</head>
<body class="min-h-screen bg-brand-cream font-body text-body">

  <div id="mobile-backdrop"></div>

  <aside id="mobile-drawer">
    <div style="display:flex;align-items:center;gap:8px;padding:0 20px;height:64px;border-bottom:1px solid rgba(255,255,255,0.1);flex-shrink:0;">
      <div style="width:36px;height:36px;border-radius:6px;background:linear-gradient(135deg,var(--brand-gold),var(--brand-gold-dark));"></div>
      <span style="font-family:var(--font-heading);font-weight:700;color:var(--brand-gold);font-size:15px;">VIS Admin</span>
      <button id="close-drawer" style="margin-left:auto;background:none;border:none;color:var(--shell-muted);cursor:pointer;font-size:22px;">✕</button>
    </div>
    <nav style="padding:16px 12px;flex:1;">
      {navGroups.map((group) => (
        <div style="margin-bottom:20px;">
          <p style="padding:0 8px;margin-bottom:4px;font-size:10px;font-family:var(--font-heading);font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--shell-muted);">
            {group.label}
          </p>
          {group.items.map((item) => (
            <a
              href={item.href}
              style={`display:flex;align-items:center;justify-content:space-between;padding:7px 10px;border-radius:6px;font-size:13px;text-decoration:none;color:${activePath === item.href ? 'var(--brand-gold)' : 'var(--shell-muted)'};background:${activePath === item.href ? 'rgba(255,255,255,0.08)' : 'transparent'};font-weight:${activePath === item.href ? '600' : '400'};`}
            >
              <span>{item.label}</span>
              {item.superAdminOnly && (
                <span style="font-size:9px;padding:2px 4px;border-radius:3px;background:rgba(201,168,76,0.2);color:var(--brand-gold);">SA</span>
              )}
            </a>
          ))}
        </div>
      ))}
    </nav>
  </aside>

  <div class="flex">
    <aside class="hidden lg:flex flex-col w-64 shrink-0 h-screen sticky top-0 bg-shell-obsidian text-shell-text border-r border-white/10 overflow-y-auto">
      <div class="flex items-center gap-2 px-5 h-16 shrink-0 border-b border-white/10">
        <div class="w-9 h-9 rounded-md bg-gradient-to-br from-brand-gold to-brand-gold-dark shadow-gold"></div>
        <span class="font-heading font-bold text-brand-gold text-[15px]">VIS Admin</span>
      </div>
      <nav class="py-4 px-3 space-y-5">
        {navGroups.map((group) => (
          <div>
            <p class="px-2 mb-1 text-[10px] font-heading font-bold uppercase tracking-wider text-shell-muted">
              {group.label}
            </p>
            <div class="space-y-0.5">
              {group.items.map((item) => (
                <a
                  href={item.href}
                  class:list={[
                    'flex items-center justify-between px-2.5 py-1.5 rounded-md text-xs transition-colors',
                    activePath === item.href
                      ? 'bg-white/10 text-brand-gold font-semibold'
                      : 'text-shell-muted hover:text-shell-text',
                  ]}
                >
                  <span>{item.label}</span>
                  {item.superAdminOnly && (
                    <span class="text-[9px] px-1 py-0.5 rounded bg-brand-gold/20 text-brand-gold">SA</span>
                  )}
                </a>
              ))}
            </div>
          </div>
        ))}
      </nav>
    </aside>

    <div class="flex-1 min-w-0">
      <nav class="lg:hidden bg-shell-obsidian text-shell-text sticky top-0 z-40 border-b border-white/10">
        <div class="px-5 h-16 flex items-center gap-3">
          <button id="open-drawer" aria-label="Open menu" class="flex flex-col gap-[5px] p-1 -ml-1">
            <span class="block w-5 h-0.5 bg-shell-text rounded"></span>
            <span class="block w-5 h-0.5 bg-shell-text rounded"></span>
            <span class="block w-5 h-0.5 bg-shell-text rounded"></span>
          </button>
          <div class="w-9 h-9 rounded-md bg-gradient-to-br from-brand-gold to-brand-gold-dark shadow-gold"></div>
          <span class="font-heading font-bold text-brand-gold text-[15px]">VIS Admin</span>
          {role && (
            <span class="ml-auto text-[10px] px-2 py-0.5 rounded-full bg-brand-gold/20 text-brand-gold font-heading font-bold uppercase tracking-wide">
              {role.replace('_', ' ')}
            </span>
          )}
        </div>
      </nav>
      <main class="max-w-[1400px] mx-auto px-5 py-8">
        <slot />
      </main>
    </div>
  </div>

  <script>
    const openBtn  = document.getElementById('open-drawer');
    const closeBtn = document.getElementById('close-drawer');
    const drawer   = document.getElementById('mobile-drawer');
    const backdrop = document.getElementById('mobile-backdrop');

    function openDrawer() {
      drawer?.classList.add('open');
      backdrop?.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeDrawer() {
      drawer?.classList.remove('open');
      backdrop?.classList.remove('open');
      document.body.style.overflow = '';
    }

    openBtn?.addEventListener('click', openDrawer);
    closeBtn?.addEventListener('click', closeDrawer);
    backdrop?.addEventListener('click', closeDrawer);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDrawer(); });
  </script>
</body>
</html>
