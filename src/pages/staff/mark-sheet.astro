---
// Real, served route at /staff/mark-sheet.
import StaffLayout from '../../layouts/StaffLayout.astro';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';
import MarkSheetIsland from '../../components/staff/MarkSheetIsland';

// The old app's renderMarkSheet() lets a subject_teacher call the
// function but immediately toasts an error and returns — the nav menu
// itself never gives them the link (Section 6496 confirms no Mark
// Sheet entry in the subject_teacher menu). Since this is a real
// server route now, subject_teacher is excluded from checkAuth's
// allowed list outright rather than allowed-then-toasted, which is
// the equivalent server-side behavior for a role with no legitimate
// path to this screen.
const auth = await checkAuth(Astro.cookies, [
  'super_admin', 'admin', 'proprietor', 'head_teacher', 'principal', 'teacher',
]);

if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

// Real school_name + logo_url from school_settings (id=1) — same table/
// row School Settings reads/writes. Previously hardcoded here; the logo
// was requested directly and school_name being a live value rather than
// a literal string is the same fix applied for the same reason.
const supabase = createServerSupabase(Astro.cookies);
const { data: ss } = await supabase.from('school_settings').select('school_name, logo_url').eq('id', 1).single();
const schoolName = ss?.school_name || 'School';
---
<StaffLayout title="Mark Sheet">
  <p class="text-sm text-brand-brown-light mb-4">
    Generate a class-wide mark sheet PDF. Signed in as role:
    <span class="font-semibold text-brand-brown-dark">{auth.role}</span>
  </p>
  <MarkSheetIsland client:load role={auth.role} userId={auth.userId} schoolName={schoolName} logoUrl={ss?.logo_url || ''} />
</StaffLayout>
