---
// Replaces the earlier stub (raw class_id UUIDs shown instead of class
// names, no class filter, no search, no way to remove a scholarship).
// Ported from renderScholarship()/loadScholarshipList()/
// removeScholarship() (index.html ~25353-25405).
//
// KNOWN GUESS, flagged rather than hidden: the "✏️ Edit" link in
// ScholarshipManager.tsx points to /admin/students?search={name} — I
// don't know whether admin/students.astro actually reads a `search`
// query param and pre-filters on load. If it doesn't, that link just
// opens the plain Students list. Check that page before relying on it;
// I have not verified it.
import AdminLayout from '../../layouts/AdminLayout.astro';
import ScholarshipManager from '../../components/admin/ScholarshipManager';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';

const auth = await checkAuth(Astro.cookies, ['super_admin', 'admin', 'proprietor', 'bursar']);
if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

const supabase = createServerSupabase(Astro.cookies);
const { data: classes, error } = await supabase.from('classes').select('id, name, arm').order('name');
---
<AdminLayout title="Scholarship" activePath="/admin/scholarship" role={auth.role}>
  <div class="flex flex-col gap-4">
    <div>
      <h1 class="font-heading font-bold text-2xl text-brand-brown-dark">Scholarship Students</h1>
      <p class="text-sm text-brand-brown-light">All students/pupils on scholarship.</p>
    </div>

    {error && (
      <div class="bg-danger-700/10 border border-danger-700 text-danger-700 text-sm rounded-md p-3">
        Could not load classes: {error.message}
      </div>
    )}

    <ScholarshipManager client:load classes={(classes ?? []) as any} />
  </div>
</AdminLayout>
