---
// Replaces the earlier stub (a table showing raw staff UUIDs and no
// Amount column). Ported from renderPayroll() (index.html ~L20578-20627)
// plus downloadPayslip() (~L20670-20797) for the per-slip PDF.
import AdminLayout from '../../layouts/AdminLayout.astro';
import PayrollManager from '../../components/admin/PayrollManager';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';
import { currentPayrollPeriod } from '../../lib/payroll';

const FINANCE_ROLES = ['super_admin', 'admin', 'proprietor', 'bursar'];
const auth = await checkAuth(Astro.cookies, FINANCE_ROLES);
if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

const period = Astro.url.searchParams.get('period') || currentPayrollPeriod();
const supabase = createServerSupabase(Astro.cookies);
const [{ data: staffList, error: staffErr }, { data: slips, error: slipsErr }, { data: schoolSettings }] = await Promise.all([
  supabase.from('profiles').select('*').neq('role', 'student').order('full_name'),
  supabase.from('payslips').select('*').eq('period', period).order('staff_name'),
  supabase.from('school_settings').select('*').limit(1).maybeSingle(),
]);
const eligible = (staffList || []).filter((s: any) => (parseFloat(s.basic_salary) || 0) > 0);
const error = staffErr || slipsErr;
---
<AdminLayout title="Staff Payroll" activePath="/admin/payroll" role={auth.role}>
  <div class="flex flex-col gap-4">
    <div>
      <h1 class="font-heading font-bold text-2xl text-brand-brown-dark">Staff Payroll</h1>
      <p class="text-sm text-brand-brown-light">Generate and manage monthly staff pay.</p>
    </div>

    {error && (
      <div class="bg-danger-700/10 border border-danger-700 text-danger-700 text-sm rounded-md p-3">
        Could not load payroll: {error.message}
      </div>
    )}

    {!error && (
      <PayrollManager client:load period={period} eligibleStaff={eligible as any} initialSlips={(slips ?? []) as any} schoolSettings={(schoolSettings ?? {}) as any} />
    )}
  </div>
</AdminLayout>
