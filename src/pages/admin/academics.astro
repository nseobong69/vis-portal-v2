---
// Replaces the earlier stub (static "No records found" table, no
// buttons, no tabs, nothing functional). Ported from renderAcademics()
// (index.html ~26279-26505) — Assignments/Lesson Notes/Videos tabs,
// create modal with cascading Class → Subject dropdown, image/video
// upload via Cloudinary, and delete.
//
// NOT covered, separate sub-features (see action.ts header comment):
//  - "AI Generate" (openAILessonModal) — external LLM integration.
//  - Full submission review UI (viewAssignmentSubmissions) — submission
//    COUNTS are shown per assignment, but grading/reviewing them isn't.
import AdminLayout from '../../layouts/AdminLayout.astro';
import AcademicsManager from '../../components/admin/AcademicsManager';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';

// Same role gate as renderAcademics() (index.html line 26280):
// isAdmin || isTeacher.
const auth = await checkAuth(Astro.cookies, [
  'super_admin', 'admin', 'head_teacher', 'principal', 'proprietor', 'teacher', 'subject_teacher',
]);
if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

const supabase = createServerSupabase(Astro.cookies);
const { data: classes, error } = await supabase.from('classes').select('id, name, arm').order('name');
---
<AdminLayout title="Academics" activePath="/admin/academics" role={auth.role}>
  <div class="flex flex-col gap-4">
    <div>
      <h1 class="font-heading font-bold text-2xl text-brand-brown-dark">Academics</h1>
      <p class="text-sm text-brand-brown-light">Manage assignments, lesson notes and class videos.</p>
    </div>

    {error && (
      <div class="bg-danger-700/10 border border-danger-700 text-danger-700 text-sm rounded-md p-3">
        Could not load classes: {error.message}
      </div>
    )}

    <AcademicsManager client:load classes={(classes ?? []) as any} />
  </div>
</AdminLayout>
