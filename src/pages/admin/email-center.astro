---
import AdminLayout from '../../layouts/AdminLayout.astro';
import EmailComposeForm from '../../components/admin/EmailComposeForm';
import EmailCenterManager from '../../components/admin/EmailCenterManager';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';

const ALLOWED_ROLES = ['super_admin', 'admin', 'proprietor', 'head_teacher', 'principal'];
const auth = await checkAuth(Astro.cookies, ALLOWED_ROLES);
if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

const supabase = createServerSupabase(Astro.cookies);
const { data: rows } = await supabase
  .from('email_delivery_log')
  .select('*')
  .order('created_at')
  .limit(100);

const sorted = (rows || []).reverse();
---
<AdminLayout title="Email Center" activePath="/admin/email-center" role={auth.role}>
  <div class="flex flex-col gap-6">
    <div>
      <h1 class="font-heading font-bold text-2xl text-brand-brown-dark">Email Center</h1>
      <p class="text-sm text-brand-brown-light">Send emails and view delivery log.</p>
    </div>

    <EmailComposeForm client:load />

    <EmailCenterManager
      client:load
      initialRows={sorted as any}
    />
  </div>
</AdminLayout>
