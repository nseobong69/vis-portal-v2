---
// Admin Portal — Email Center
// EmailJS send now wired through /api/admin/email/send.ts (reuses the
// EMAILJS_* pattern from api/student/profile/send-otp.ts) and every
// attempt — sent or failed — is logged to email_delivery_log below.
import AdminLayout from '../../layouts/AdminLayout.astro';
import Card from '../../components/ui/Card';
import Table from '../../components/ui/Table';
import EmailComposeForm from '../../components/admin/EmailComposeForm';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';

const auth = await checkAuth(Astro.cookies, ['super_admin', 'admin', 'proprietor', 'head_teacher', 'principal']);

if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

const supabase = createServerSupabase(Astro.cookies);
const { data: rows, error } = await supabase
  .from('email_delivery_log')
  .select('*')
  .limit(25);

const columns = [
  { key: 'recipient', header: 'Recipient' },
  { key: 'subject', header: 'Subject' },
  { key: 'status', header: 'Status' }
];
---
<AdminLayout title="Email Center" activePath="/admin/email-center" role={auth.role}>
  <Card title="Compose">
    <EmailComposeForm client:load />
  </Card>
  <div class="h-4"></div>
  <Card title="Delivery Log">
    {error && (
      <p class="text-sm text-red-600 mb-3">
        Query against `email_delivery_log` failed — table/columns not verified against the live
        schema yet (same as-audited-not-verified caveat as Phase 0's table list).
      </p>
    )}
    <Table
      columns={columns}
      rows={(rows ?? []) as any[]}
      getRowKey={(row: any) => String(row.id ?? JSON.stringify(row))}
    />
  </Card>
</AdminLayout>
