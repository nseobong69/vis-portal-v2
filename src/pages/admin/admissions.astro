---
// Replaces the earlier stub (bare 2-column table: Applicant/Status,
// no name even shown correctly, no stats, no actions). Ported from
// renderAdmissions() (index.html ~21566-21598) — full stats cards,
// applicant table, and real Approve/Reject/Confirm Payment/Delete
// actions (approveAdm() ports the FULL business logic: payment gate,
// random class-arm assignment, student record creation, auto-invoice —
// not just a status flip).
//
// CHANGED in this pass:
//   - admission_fee_configs also fetched and passed as initialFeeConfigs
//     so InternalAdmissionModal can apply the 3-priority fee chain:
//     per-class ID → section fee → global default (matching the old
//     app's onAdmClassChange() exactly).
//   - PDF and email are now wired — see InternalAdmissionModal.tsx.
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdmissionsManager from '../../components/admin/AdmissionsManager';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';

const auth = await checkAuth(Astro.cookies, ['super_admin', 'admin', 'proprietor']);
if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

const supabase = createServerSupabase(Astro.cookies);
const [{ data: admissions, error }, { data: classes }, { data: ss }] = await Promise.all([
  supabase.from('admissions').select('*').order('created_at', { ascending: false }),
  supabase.from('classes').select('id, name, arm').order('name'),
  supabase.from('school_settings')
    .select('admission_fee_default, admission_fee_sections, admission_fee_configs, admission_cbt_configs')
    .eq('id', 1).single(),
]);

function safeParseJSON(val: any, fallback: any) {
  if (!val) return fallback;
  if (typeof val !== 'string') return val;
  try { return JSON.parse(val); } catch { return fallback; }
}
const initialFeeSections = safeParseJSON(ss?.admission_fee_sections, {});
const initialFeeConfigs  = safeParseJSON(ss?.admission_fee_configs,  {});
const initialCbtConfigs  = safeParseJSON(ss?.admission_cbt_configs,  {});
---
<AdminLayout title="Admissions" activePath="/admin/admissions" role={auth.role}>
  <div class="flex flex-col gap-4">
    <div>
      <h1 class="font-heading font-bold text-2xl text-brand-brown-dark">Admissions</h1>
      <p class="text-sm text-brand-brown-light">Manage admission applications.</p>
    </div>

    {error && (
      <div class="bg-danger-700/10 border border-danger-700 text-danger-700 text-sm rounded-md p-3">
        Could not load admissions: {error.message}
      </div>
    )}

    <AdmissionsManager
      client:load
      admissions={(admissions ?? []) as any}
      classes={(classes ?? []) as any}
      role={auth.role}
      publicFormUrl="/admissions"
      initialFeeDefault={ss?.admission_fee_default ?? 0}
      initialFeeSections={initialFeeSections}
      initialFeeConfigs={initialFeeConfigs}
      initialCbtConfigs={initialCbtConfigs}
    />
  </div>
</AdminLayout>
