---
// Replaces the earlier stub (a flat, non-interactive list of "Current
// Name" values — no class picker, no way to actually do anything).
// Ported from renderFixNameOrder()/_fnoRenderStudentsTab()/
// _fnoRenderStaffTab() (index.html ~8009-8196): Students (class by
// class) and Staff tabs, per-row Surname/First-name word-position
// dropdowns with a live "After Reorder" preview, a pattern-by-position
// bulk-apply box for rows sharing the same wrong order, and a
// confirm-before-write modal since this cannot be auto-undone.
import AdminLayout from '../../layouts/AdminLayout.astro';
import FixNameOrderIsland from '../../components/admin/FixNameOrderIsland';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';

const auth = await checkAuth(Astro.cookies, ['super_admin', 'admin', 'proprietor']);
if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

const supabase = createServerSupabase(Astro.cookies);
const { data: classes, error } = await supabase.from('classes').select('id, name, arm').order('name');
---
<AdminLayout title="Fix Name Order" activePath="/admin/fix-name-order" role={auth.role}>
  <div class="flex flex-col gap-4">
    <div>
      <h1 class="font-heading font-bold text-2xl text-brand-brown-dark">Fix Name Order</h1>
      <p class="text-sm text-brand-brown-light">Bulk-swap first/last name order — for names entered the wrong way round.</p>
    </div>

    {error && (
      <div class="bg-danger-700/10 border border-danger-700 text-danger-700 text-sm rounded-md p-3">
        Could not load classes: {error.message}
      </div>
    )}

    <FixNameOrderIsland client:load classes={(classes ?? []) as any} />
  </div>
</AdminLayout>
