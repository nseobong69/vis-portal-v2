---
// Admin Portal — Public Posts (CMS)
// CRUD wired: add (AdminRecordForm) + delete, both through the
// whitelisted /api/admin/records endpoint (Section: TABLE_FIELDS).
// Edit-in-place is still not implemented — add + delete only.
import AdminLayout from '../../layouts/AdminLayout.astro';
import Card from '../../components/ui/Card';
import AdminCrudList from '../../components/admin/AdminCrudList';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';

const auth = await checkAuth(Astro.cookies, ['super_admin', 'admin', 'proprietor', 'head_teacher', 'principal']);

if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

const supabase = createServerSupabase(Astro.cookies);
const { data: rows, error } = await supabase
  .from('public_posts')
  .select('*')
  .limit(50);

const columns = [
  { key: 'title', header: 'Title' },
  { key: 'published', header: 'Published' }
];
const formFields = [
  { key: 'title', label: 'Title', type: 'text' },
  { key: 'body', label: 'Body', type: 'text' },
  { key: 'published', label: 'Published', type: 'checkbox' }
];
---
<AdminLayout title="Public Posts (CMS)" activePath="/admin/public-posts" role={auth.role}>
  <Card title="Public Posts (CMS)">
    {error && (
      <p class="text-sm text-red-600 mb-3">
        Query against `public_posts` failed — table/columns not verified against the live
        schema yet (same as-audited-not-verified caveat as Phase 0's table list).
      </p>
    )}
    <AdminCrudList
      client:load
      table="public_posts"
      columns={columns}
      formFields={formFields}
      initialRows={(rows ?? []) as any[]}
    />
  </Card>
</AdminLayout>
