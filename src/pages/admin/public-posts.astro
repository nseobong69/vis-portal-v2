---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';
import PublicPostsIsland from '../../components/admin/PublicPostsIsland';

const auth = await checkAuth(Astro.cookies, [
  'super_admin', 'admin', 'proprietor', 'head_teacher', 'principal',
]);
if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

const supabase = createServerSupabase(Astro.cookies);
const { data: posts } = await supabase
  .from('public_posts').select('*').order('created_at', { ascending: false }).limit(100);
---
<AdminLayout title="Public Posts" activePath="/admin/public-posts" role={auth.role}>
  <PublicPostsIsland
    client:load
    initialPosts={(posts ?? []) as any}
    userId={auth.userId}
    userRole={auth.role}
  />
</AdminLayout>
