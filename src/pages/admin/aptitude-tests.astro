---
// Replaces the aptitude_codes stub. Ported from renderAptitudeTests()
// (index.html ~L11024-11075). Table: cbt_exams where exam_type='aptitude'.
// Full screen: card grid, create, activate/deactivate, questions, delete.
import AdminLayout from '../../layouts/AdminLayout.astro';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';
import AptitudeTestsIsland from '../../components/admin/AptitudeTestsIsland';

const auth = await checkAuth(Astro.cookies, [
  'super_admin', 'admin', 'proprietor', 'head_teacher', 'principal',
]);
if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

const supabase = createServerSupabase(Astro.cookies);
const [{ data: exams }, { data: classes }] = await Promise.all([
  supabase.from('cbt_exams').select('*').eq('exam_type', 'aptitude').order('created_at', { ascending: false }),
  supabase.from('classes').select('id, name').order('name'),
]);
---
<AdminLayout title="Aptitude Tests" activePath="/admin/aptitude-tests" role={auth.role}>
  <AptitudeTestsIsland
    client:load
    initialExams={(exams ?? []) as any}
    classes={(classes ?? []) as any}
  />
</AdminLayout>
