---
// Admin Portal — Attendance (Admin Oversight)
// The real marking/PDF/Excel-export logic lives in staff/attendance from the Staff/Teacher Portal phase (not yet built out past the week-panel shell either, per that phase's README). This route is the admin-tier cross-class view only.
import AdminLayout from '../../layouts/AdminLayout.astro';
import Card from '../../components/ui/Card';
import Table from '../../components/ui/Table';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';

const auth = await checkAuth(Astro.cookies, ['super_admin', 'admin', 'proprietor', 'head_teacher', 'principal']);

if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

const supabase = createServerSupabase(Astro.cookies);
const { data: rows, error } = await supabase
  .from('attendance_week_logs')
  .select('*')
  .limit(25);

const columns = [
  { key: 'session', header: 'Session' },
  { key: 'term', header: 'Term' },
  { key: 'class_id', header: 'Class' },
  { key: 'week_number', header: 'Week' }
];
---
<AdminLayout title="Attendance (Admin Oversight)" activePath="/admin/attendance" role={auth.role}>
  <Card title="Attendance (Admin Oversight)">
    {error && (
      <p class="text-sm text-red-600 mb-3">
        Query against `attendance_week_logs` failed — table/columns not verified against the live
        schema yet (same as-audited-not-verified caveat as Phase 0's table list).
      </p>
    )}
    <Table
      columns={columns}
      rows={(rows ?? []) as any[]}
      getRowKey={(row: any) => String(row.id ?? JSON.stringify(row))}
    />
  </Card>
</AdminLayout>
