---
// Replaces the earlier stub (a flat table of attendance_week_logs rows
// showing raw class_id UUIDs, with no filtering). Ported from the
// admin-facing half of renderAttendance()/loadWeekPanel() (index.html
// ~L12094-12230) — the class/session/term-scoped list of weeks and how
// many of the 5 school days in each are marked done.
//
// SCOPE: this is read-only oversight for admin-tier roles (matching the
// "Attendance (Admin Oversight)" title already on the stub). The old
// app's actual day-by-day marking workflow — a teacher opening a
// specific week and ticking present/absent per student — is a separate,
// larger piece (loadWeekView() and its per-student toggle UI, index.html
// ~L12230+).
//
// UPDATED: that marking workflow does NOT need rebuilding here — it's
// already built as AttendanceMarker.tsx, and /staff/attendance already
// permits every admin-tier role (super_admin/admin/proprietor/
// head_teacher/principal), same as this page. Its autoLockClass prop is
// only true for the literal 'teacher' role, so admin-tier visitors get
// a full, unlocked class selector there today — this page was just
// missing a link to it. Added below, no new marking UI built.
import AdminLayout from '../../layouts/AdminLayout.astro';
import AttendanceOversight from '../../components/admin/AttendanceOversight';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';

const auth = await checkAuth(Astro.cookies, [
  'super_admin', 'admin', 'proprietor', 'head_teacher', 'principal',
]);
if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

const supabase = createServerSupabase(Astro.cookies);
const [{ data: weeks, error }, { data: classes }] = await Promise.all([
  supabase.from('attendance_week_logs').select('*').order('session', { ascending: false }).order('week_number'),
  supabase.from('classes').select('id, name, arm, level').order('name'),
]);

// Same head_teacher (KG/Nursery/Primary) vs principal (Secondary) scoping
// used elsewhere in this app (e.g. classes.astro).
let visibleClasses = classes || [];
if (auth.role === 'head_teacher') {
  visibleClasses = visibleClasses.filter((c) => ['kindergarten', 'nursery', 'primary'].includes((c.level || '').toLowerCase()));
} else if (auth.role === 'principal') {
  visibleClasses = visibleClasses.filter((c) => (c.level || '').toLowerCase() === 'secondary');
}
const classById = new Map(visibleClasses.map((c) => [c.id, `${c.name}${c.arm ? ' ' + c.arm : ''}`]));
const visibleClassIds = new Set(visibleClasses.map((c) => c.id));

const rows = (weeks || [])
  .filter((w) => visibleClassIds.has(w.class_id))
  .map((w) => ({
    id: w.id,
    session: w.session,
    term: w.term,
    class_name: classById.get(w.class_id) || 'Unknown class',
    week_number: w.week_number,
    status: w.status,
    days_completed: (w.days_completed || []).length,
  }));
---
<AdminLayout title="Attendance" activePath="/admin/attendance" role={auth.role}>
  <div class="flex flex-col gap-4">
    <div class="flex items-start justify-between gap-4 flex-wrap">
      <div>
        <h1 class="font-heading font-bold text-2xl text-brand-brown-dark">Attendance (Admin Oversight)</h1>
        <p class="text-sm text-brand-brown-light">Read-only view of every class's weekly attendance progress.</p>
      </div>
      <a
        href="/staff/attendance"
        class="shrink-0 bg-brand-gold text-shell-obsidian shadow-gold hover:brightness-105 text-sm font-semibold px-4 py-2 rounded-sm"
      >
        ✏️ Mark Attendance
      </a>
    </div>
    <p class="text-xs text-brand-brown-light -mt-2">
      Day-by-day marking is normally done by the class teacher, but any admin-tier role can mark or fix a class's attendance directly — the button above opens the same marking screen teachers use, with a full class selector unlocked.
    </p>

    {error && (
      <div class="bg-danger-700/10 border border-danger-700 text-danger-700 text-sm rounded-md p-3">
        Could not load attendance: {error.message}
      </div>
    )}

    <AttendanceOversight rows={rows as any} classes={visibleClasses.map((c) => ({ id: c.id, name: `${c.name}${c.arm ? ' ' + c.arm : ''}` }))} />
  </div>
</AdminLayout>
