---
// Admin Portal — ID Cards
// Cloudinary photo upload wired (sign-photo-upload.ts, same signature
// pattern as the CBT proctoring uploads). QR/barcode: FIXED — the CDN
// script-tag approach (QRCode.js/JsBarcode from cdnjs) was failing in
// production ("Could not load QR/barcode libraries from cdnjs" —
// cdnjs unreachable/blocked from this deployment). Now uses the
// `qrcode` and `jsbarcode` npm packages as real bundled imports
// instead. face-api.js face-matching against the photo is NOT
// included — that's a much bigger lift than a card layout and stays a
// follow-up.
import AdminLayout from '../../layouts/AdminLayout.astro';
import Card from '../../components/ui/Card';
import IdCardGenerator from '../../components/admin/IdCardGenerator';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';

const auth = await checkAuth(Astro.cookies, ['super_admin', 'admin', 'proprietor', 'head_teacher', 'principal']);

if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

const supabase = createServerSupabase(Astro.cookies);
const { data: rows, error } = await supabase
  .from('students')
  .select('*')
  .limit(50);
---
<AdminLayout title="ID Cards" activePath="/admin/id-cards" role={auth.role}>
  <Card title="ID Cards">
    {error && (
      <p class="text-sm text-red-600 mb-3">
        Query against `students` failed — table/columns not verified against the live
        schema yet (same as-audited-not-verified caveat as Phase 0's table list).
      </p>
    )}
    <IdCardGenerator client:load students={(rows ?? []) as any[]} />
  </Card>
</AdminLayout>
