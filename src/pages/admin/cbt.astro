---
// Replaces the earlier stub (a table that always showed "No records
// found" because nothing ever queried cbt_exams). Ported from the exam
// list + create-exam form in renderCBT() (index.html ~L10527-10600) and
// the insert shape from its save handler (~L10967-10985).
//
// SCOPE: exam creation + listing only (title, class, subject, term,
// duration, status). The old app's question bank builder, live exam-
// taking flow, auto-grading, and violation/proctoring logs (cbt_questions,
// cbt_exam_students, cbt_submissions, cbt_snapshots, cbt_violations,
// index.html ~L11030-11553+) are a materially larger, separate feature
// and aren't ported here — an exam created on this screen has no
// questions yet until that follow-up lands.
import AdminLayout from '../../layouts/AdminLayout.astro';
import CbtExamsManager from '../../components/admin/CbtExamsManager';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';

const auth = await checkAuth(Astro.cookies, [
  'super_admin', 'admin', 'proprietor', 'head_teacher', 'principal', 'teacher', 'subject_teacher',
]);
if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

const supabase = createServerSupabase(Astro.cookies);
const [{ data: exams, error }, { data: classes }, { data: subjects }] = await Promise.all([
  supabase.from('cbt_exams').select('*').order('created_at', { ascending: false }),
  supabase.from('classes').select('id, name, arm').order('name'),
  supabase.from('subjects').select('id, name').order('name'),
]);
---
<AdminLayout title="CBT Exams" activePath="/admin/cbt" role={auth.role}>
  <div class="flex flex-col gap-4">
    <div>
      <h1 class="font-heading font-bold text-2xl text-brand-brown-dark">CBT Module (Admin)</h1>
      <p class="text-sm text-brand-brown-light">Create exam shells here, then add questions once the question-bank screen is ready.</p>
    </div>

    {error && (
      <div class="bg-danger-700/10 border border-danger-700 text-danger-700 text-sm rounded-md p-3">
        Could not load exams: {error.message}
      </div>
    )}

    <CbtExamsManager
      client:load
      exams={(exams ?? []) as any}
      classes={(classes ?? []) as any}
      subjects={(subjects ?? []) as any}
    />
  </div>
</AdminLayout>
