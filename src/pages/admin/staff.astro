---
// Admin Portal — Staff & Teachers
// Filtered to staff-tier roles client-side once real auth/session shape is confirmed (see README item 3) — this pass selects the raw profiles table.
import AdminLayout from '../../layouts/AdminLayout.astro';
import Card from '../../components/ui/Card';
import Table from '../../components/ui/Table';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';

const auth = await checkAuth(Astro.cookies, ['super_admin', 'admin', 'proprietor', 'head_teacher', 'principal']);

if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

// Filtered to staff-tier roles now that the checklist calls this out
// specifically — 'profiles.role' is still the same unverified column
// assumption auth.ts already carries (see main README item 3), so this
// filter is only as trustworthy as that assumption is.
const STAFF_ROLES = ['teacher', 'head_teacher', 'principal', 'admin', 'proprietor', 'super_admin'];
const supabase = createServerSupabase(Astro.cookies);
const { data: rows, error } = await supabase
  .from('profiles')
  .select('*')
  .in('role', STAFF_ROLES)
  .limit(50);

const columns = [
  { key: 'full_name', header: 'Name' },
  { key: 'role', header: 'Role' }
];
---
<AdminLayout title="Staff & Teachers" activePath="/admin/staff" role={auth.role}>
  <Card title="Staff & Teachers">
    {error && (
      <p class="text-sm text-red-600 mb-3">
        Query against `profiles` failed — table/columns not verified against the live
        schema yet (same as-audited-not-verified caveat as Phase 0's table list).
      </p>
    )}
    <Table
      columns={columns}
      rows={(rows ?? []) as any[]}
      getRowKey={(row: any) => String(row.id ?? JSON.stringify(row))}
    />
  </Card>
</AdminLayout>
