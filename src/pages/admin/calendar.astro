---
// Replaces the school_day_status stub. Ported from renderCalendar()
// (index.html ~L21339-21388). Table: school_calendar, columns:
// title, event_date, event_type. Upcoming/Past split matches the old
// app exactly.
import AdminLayout from '../../layouts/AdminLayout.astro';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';
import SchoolCalendarIsland from '../../components/admin/SchoolCalendarIsland';

const auth = await checkAuth(Astro.cookies, [
  'super_admin', 'admin', 'proprietor', 'head_teacher', 'principal',
]);
if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

const supabase = createServerSupabase(Astro.cookies);
const { data: events } = await supabase
  .from('school_calendar')
  .select('*')
  .order('event_date', { ascending: true });
---
<AdminLayout title="School Calendar" activePath="/admin/calendar" role={auth.role}>
  <p class="text-sm text-brand-brown-light mb-4">Events, exams, and holidays.</p>
  <SchoolCalendarIsland
    client:load
    initialEvents={(events ?? []) as any}
    canManage={true}
  />
</AdminLayout>
