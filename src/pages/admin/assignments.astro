---
// Real, server-served route at /admin/assignments — direct URL loads hit
// this file's actual server-rendered HTML (Astro output: 'server'), no
// client router involved.
//
// REPLACES the previous version of this file, which incorrectly queried
// `academic_assignments` (homework/coursework — Feature Checklist row 15,
// Academics) under the "Assignments" label. The correct feature for this
// route is Feature Checklist row 9: "Assign teachers to classes and
// subjects" — ported from the old app's renderAssignments().
import AdminLayout from '../../layouts/AdminLayout.astro';
import { checkAuth } from '../../lib/auth';
import TeacherAssignmentsIsland from '../../components/admin/TeacherAssignmentsIsland';

// Roles allowed, per the Feature Checklist (row 9: Assignments) — matches
// the old app: super_admin, admin, proprietor, head_teacher, principal.
// teacher/subject_teacher are NOT included — this is an admin-tier tool,
// not something a teacher assigns to themselves.
const auth = await checkAuth(Astro.cookies, [
  'super_admin', 'admin', 'proprietor', 'head_teacher', 'principal',
]);

if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}
---
<AdminLayout title="Assignments" activePath="/admin/assignments" role={auth.role}>
  <p class="text-sm text-brand-brown-light mb-4">Assign teachers to classes and subjects.</p>

  <!--
    client:load — class/teacher selects, the subject-teacher panel, and
    the class-teacher panel all need to be interactive from first paint,
    same reasoning as ResultsSheetIsland / MonitorScoresIsland.
  -->
  <TeacherAssignmentsIsland client:load />
</AdminLayout>
