---
// Real route at /admin/settings. Same auth-before-data pattern as
// staff/attendance.astro (Section 3): server-side role check runs first,
// then — and only then — real school_settings data is fetched and
// rendered. This page now ports all 18 of the old app's SS_SECTIONS
// (index.html ~line 17580). The only things intentionally NOT covered,
// because they are not simple school_settings columns, are:
//  - 'signatures_stamps' Classes tab -> separate `class_signatures` table
//  - 'admissions_fees' per-class fee override -> separate per-class UI
//
// ADDED: Passing Mark (%) in the Academic Calendar card — was missing
// entirely (school_settings.pass_mark). Old app placement: inside the
// Academic Calendar card, right after "Next Term Begins Date"
// (index.html ~line 16643-16647). Drives PASS_MARK()/passFail() across
// every result/mark-sheet/combined-PDF screen — those all default to 40
// when this is unset, so this field was never *broken*, just never
// exposed to change it from the UI.
import StaffLayout from '../../layouts/AdminLayout.astro';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';
import Card from '../../components/ui/Card';
import ApartCardsEditor from '../../components/admin/ApartCardsEditor';
import LeadershipCardsEditor from '../../components/admin/LeadershipCardsEditor';
import SignatoriesEditor from '../../components/admin/SignatoriesEditor';
import LifeTabsEditor from '../../components/admin/LifeTabsEditor';

const ALL_SESSIONS = ['2024/2025', '2025/2026', '2026/2027', '2027/2028', '2028/2029'];

// Old app gates this whole screen "School Settings (super_admin only)"
// (see the screenshot) — same restriction here.
const auth = await checkAuth(Astro.cookies, ['super_admin']);

if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

const supabase = createServerSupabase(Astro.cookies);
const { data: ss, error } = await supabase
  .from('school_settings')
  .select(`
    school_name, motto, address, phone1, phone2, email, logo_url, hero_image_url,
    hp_apart_cards,
    current_session, current_term, term_end_date, next_term_date, pass_mark,
    primary_color, secondary_color,
    admission_signatory_name, admission_signatory_role, admission_signatory_signature, admission_signatory_stamp,
    finance_signatory_name, finance_signatory_role, finance_signatory_signature, finance_signatory_stamp,
    hp_leadership_cards, hp_leadership_heading, hp_leadership_subtitle,
    paystack_public_key, remita_public_key, bank_name, bank_account_name, bank_account_number, payment_phone,
    emailjs_service_id, emailjs_template_id, emailjs_public_key, reply_email,
    admission_fee_default, invigilator_pin, apk_url,
    adm_card_image_url, adm_card_badge, adm_card_badge_show, adm_card_intro, adm_card_steps, adm_card_docs,
    hp_news_heading, hp_news_subtext,
    public_tagline, public_contact_visible, public_admission_btn, public_cbt_btn, public_feed_visible,
    social_facebook, social_instagram, social_youtube, social_linkedin, social_twitter,
    hp_hero_tag, hp_hero_headline, hp_hero_sub, hp_hero_cta_primary, hp_hero_cta_secondary, hp_stats,
    hp_life_tabs,
    hp_story_1_eyebrow, hp_story_1_heading, hp_story_1_body, hp_story_1_cta1, hp_story_1_cta2,
    hp_story_2_heading, hp_story_2_body, hp_story_wisdom,
    hp_story_3_heading, hp_story_3_body, hp_story_courage,
    hp_story_4_heading, hp_story_4_body, hp_story_compassion,
    acad_page_nav_title, acad_page_heading, acad_page_intro,
    acad_level_1_icon, acad_level_1_title, acad_level_1_body,
    acad_level_2_icon, acad_level_2_title, acad_level_2_body,
    acad_level_3_icon, acad_level_3_title, acad_level_3_body,
    acad_level_4_icon, acad_level_4_title, acad_level_4_body,
    acad_strengths_title, acad_strength_1, acad_strength_2, acad_strength_3, acad_strength_4, acad_strength_5,
    about_intro,
    about_val_1_icon, about_val_1_title, about_val_1_body,
    about_val_2_icon, about_val_2_title, about_val_2_body,
    about_val_3_icon, about_val_3_title, about_val_3_body,
    about_val_4_icon, about_val_4_title, about_val_4_body
  `)
  .eq('id', 1)
  .single();

// Same defensive JSON.parse the old app does (index.html ~line 17901) —
// hp_apart_cards is stored as a JSON string, not a native array column.
let apartCards: Array<{ icon: string; title: string; body: string; cta: string; img: string; bg: string }> = [];
if (ss?.hp_apart_cards) {
  try {
    const raw = typeof ss.hp_apart_cards === 'string' ? JSON.parse(ss.hp_apart_cards) : ss.hp_apart_cards;
    if (Array.isArray(raw)) apartCards = raw;
  } catch {
    apartCards = [];
  }
}

const identity = {
  school_name: ss?.school_name || '',
  motto: ss?.motto || '',
  address: ss?.address || '',
  phone1: ss?.phone1 || '',
  phone2: ss?.phone2 || '',
  email: ss?.email || '',
  logo_url: ss?.logo_url || '',
  hero_image_url: ss?.hero_image_url || '',
};

const calendar = {
  current_session: ss?.current_session || '2025/2026',
  current_term: ss?.current_term || '1st Term',
  term_end_date: ss?.term_end_date || '',
  next_term_date: ss?.next_term_date || '',
  // Same fallback as PASS_MARK() in the old app (index.html line 5348):
  // isNaN(v) ? 40 : v.
  pass_mark: ss?.pass_mark != null ? ss.pass_mark : 40,
};

const colours = {
  primary_color: ss?.primary_color || '#5D4037',
  secondary_color: ss?.secondary_color || '#F8F1E3',
};

const admissionSignatory = {
  name: ss?.admission_signatory_name || '',
  role: ss?.admission_signatory_role || 'Principal',
  signature: ss?.admission_signatory_signature || '',
  stamp: ss?.admission_signatory_stamp || '',
};
const financeSignatory = {
  name: ss?.finance_signatory_name || '',
  role: ss?.finance_signatory_role || 'School Director',
  signature: ss?.finance_signatory_signature || '',
  stamp: ss?.finance_signatory_stamp || '',
};

let leadershipCards: Array<{ photo: string; name: string; position: string; bio: string }> = [];
if (ss?.hp_leadership_cards) {
  try {
    const raw = typeof ss.hp_leadership_cards === 'string' ? JSON.parse(ss.hp_leadership_cards) : ss.hp_leadership_cards;
    if (Array.isArray(raw)) leadershipCards = raw;
  } catch {
    leadershipCards = [];
  }
}
const leadershipHeading = ss?.hp_leadership_heading || 'School Administration';
const leadershipSubtitle = ss?.hp_leadership_subtitle || 'The people guiding the school every day.';

// Same defaults saveSchoolSettings()/renderSchoolSettings() falls back to
// (index.html ~line 16948-16970) when adm_card_steps/adm_card_docs are empty.
let admCardSteps: Array<{ icon: string; title: string; body: string }> = [];
try {
  const raw = typeof ss?.adm_card_steps === 'string' ? JSON.parse(ss.adm_card_steps) : ss?.adm_card_steps;
  if (Array.isArray(raw) && raw.length) admCardSteps = raw;
} catch { /* fall through to defaults below */ }
if (!admCardSteps.length) {
  admCardSteps = [
    { icon: '📋', title: 'Complete the Form', body: "Fill in the online admission form with the applicant's personal, academic and health details." },
    { icon: '📁', title: 'Submit Documents', body: 'Attach recent passport photo, birth certificate, last school report and immunisation card.' },
    { icon: '💳', title: 'Pay Admission Fee', body: 'Make a secure online payment via Paystack or Remita to confirm your application.' },
    { icon: '📞', title: 'Interview & Review', body: 'The school will contact you to schedule a brief interview and entrance assessment where applicable.' },
    { icon: '✅', title: 'Receive Admission', body: 'Successful candidates receive an admission letter and class placement from the school office.' },
  ];
}

let admCardDocs: string[] = [];
try {
  const raw = typeof ss?.adm_card_docs === 'string' ? JSON.parse(ss.adm_card_docs) : ss?.adm_card_docs;
  if (Array.isArray(raw) && raw.length) admCardDocs = raw;
} catch { /* fall through to defaults below */ }
if (!admCardDocs.length) {
  admCardDocs = [
    'Recent passport photograph', 'Original birth certificate',
    'Last school report card / terminal result', 'Immunisation / health record',
    'National ID or passport of parent/guardian',
  ];
}

// Same defaults the old app falls back to (index.html ~line 17133) when
// hp_stats is empty.
let stats: Array<{ icon: string; number: string; suffix: string; caption: string }> = [];
try {
  const raw = typeof ss?.hp_stats === 'string' ? JSON.parse(ss.hp_stats) : ss?.hp_stats;
  if (Array.isArray(raw) && raw.length) stats = raw;
} catch { /* fall through to defaults below */ }
if (!stats.length) {
  stats = [
    { icon: '👥', number: '25', suffix: '', caption: 'Average class size' },
    { icon: '🏫', number: '3', suffix: ' levels', caption: 'Nursery, Primary & Secondary' },
    { icon: '🌍', number: '100', suffix: '%', caption: "Committed to every child's growth" },
  ];
}

// Same defaults window._HP_LIFE_DEFAULTS falls back to (index.html
// ~line 18138) when hp_life_tabs is empty.
let lifeTabs: Array<{ icon: string; label: string; title: string; body: string; cta: string; img: string }> = [];
try {
  const raw = typeof ss?.hp_life_tabs === 'string' ? JSON.parse(ss.hp_life_tabs) : ss?.hp_life_tabs;
  if (Array.isArray(raw) && raw.length) lifeTabs = raw;
} catch { /* fall through to defaults below */ }
if (!lifeTabs.length) {
  lifeTabs = [
    { icon: '⚽', label: 'Athletics & Sports', title: 'Athletics & Sports',
      body: 'From the football pitch to the track field, our athletics programme keeps students active, resilient, and team-spirited — building discipline and camaraderie every season.',
      cta: 'Join a Team', img: '' },
    { icon: '🌟', label: 'Talents Hunt', title: 'Talents Hunt',
      body: "Our annual Talents Hunt gives every student a stage. Whether it's singing, spoken word, dance, drama, or comedy — students shine in front of the whole school community.",
      cta: 'Discover Yours', img: '' },
    { icon: '🎭', label: 'Clubs & Activities', title: 'Clubs & Activities',
      body: 'From the Debate Club to the Literary and Science Clubs — every club is student-led and faculty-supported, fostering leadership and creativity at every level.',
      cta: 'Find Your Club', img: '' },
    { icon: '🎯', label: 'Career Guidance', title: 'Career Guidance',
      body: 'Our counsellors walk alongside students from JSS1 through SS3, helping them identify strengths, explore professions, and make informed choices about their future.',
      cta: 'Plan Your Future', img: '' },
    { icon: '🎉', label: 'Celebrations & Events', title: 'Celebrations & Events',
      body: "End-of-term parties, graduation ceremonies, cultural days, and prize-giving events — joyful moments that bring students, staff, and families together and create lasting memories.",
      cta: "See What's On", img: '' },
  ];
}

const academicLevelDefaults = [
  { icon: '🧸', title: 'Crèche & Nursery', body: 'Our Early Years programme provides a safe, stimulating environment where little ones build foundational language, numeracy, and social skills through play-based learning.' },
  { icon: '✏️', title: 'Primary (Pry 1 – 6)', body: 'A structured, engaging curriculum covering English, Mathematics, Basic Science, Social Studies, Cultural & Creative Arts, and more — aligned with the Nigerian national curriculum.' },
  { icon: '📐', title: 'Junior Secondary (JSS 1 – 3)', body: 'Students deepen knowledge across core subjects, begin STEM specialisation, and develop critical thinking skills to prepare for the BECE and senior school transition.' },
  { icon: '🎓', title: 'Senior Secondary (SSS 1 – 3)', body: 'Science, Arts and Commercial tracks allow students to focus on their strengths and career aspirations, preparing thoroughly for WAEC, NECO, JAMB and beyond.' },
];
const academicStrengthDefaults = [
  'Strong pass rates in WAEC & NECO examinations',
  'CBT-based entrance assessments for fair placement',
  'Regular inter-school academic competitions',
  'Dedicated STEM lab and digital learning resources',
  'Small class sizes for personalised attention',
];
const aboutValueDefaults = [
  { icon: '💡', title: 'Learning with Purpose', body: `At ${ss?.school_name || 'our school'}, a world-class education cultivates critical thinking, creative problem-solving, and the essential qualities of global citizenship.` },
  { icon: '🕊️', title: 'Peace through Understanding', body: 'We believe knowledge is most powerful when paired with humility. Our students learn to listen deeply, think critically, and lead with wisdom.' },
  { icon: '💪', title: 'Strength through Difference', body: 'Diversity is not a challenge to manage — it is a strength to celebrate. We build a community where every background and viewpoint is welcomed.' },
  { icon: '🤝', title: 'Empathy in Action', body: 'Compassion is not a feeling alone — it is a choice we make every day. We nurture students who see needs around them and respond with genuine care.' },
];
---
<StaffLayout title="School Settings">
  <div class="flex flex-col gap-6 max-w-[760px]">
    <div>
      <h1 class="font-heading font-bold text-2xl text-brand-brown-dark">School Settings</h1>
      <p class="text-sm text-brand-brown-light">super_admin only</p>
    </div>

    {error && (
      <div class="bg-danger-700/10 border border-danger-700 text-danger-700 text-sm rounded-md p-3">
        Could not load school_settings: {error.message}
      </div>
    )}

    <Card title="School Identity">
      <form id="identity-form" class="flex flex-col gap-4">
        <div class="flex flex-col gap-1">
          <label for="id-school_name" class="text-sm font-medium text-brand-brown-dark">School Name</label>
          <input id="id-school_name" name="school_name" value={identity.school_name}
            class="font-body text-sm rounded-sm border border-brand-cream-dark px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-brand-gold" />
        </div>
        <div class="flex flex-col gap-1">
          <label for="id-motto" class="text-sm font-medium text-brand-brown-dark">Motto</label>
          <input id="id-motto" name="motto" value={identity.motto}
            class="font-body text-sm rounded-sm border border-brand-cream-dark px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-brand-gold" />
        </div>
        <div class="flex flex-col gap-1">
          <label for="id-address" class="text-sm font-medium text-brand-brown-dark">Address</label>
          <input id="id-address" name="address" value={identity.address}
            class="font-body text-sm rounded-sm border border-brand-cream-dark px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-brand-gold" />
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="flex flex-col gap-1">
            <label for="id-phone1" class="text-sm font-medium text-brand-brown-dark">Phone 1</label>
            <input id="id-phone1" name="phone1" value={identity.phone1}
              class="font-body text-sm rounded-sm border border-brand-cream-dark px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-brand-gold" />
          </div>
          <div class="flex flex-col gap-1">
            <label for="id-phone2" class="text-sm font-medium text-brand-brown-dark">Phone 2</label>
            <input id="id-phone2" name="phone2" value={identity.phone2}
              class="font-body text-sm rounded-sm border border-brand-cream-dark px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-brand-gold" />
          </div>
        </div>
        <div class="flex flex-col gap-1">
          <label for="id-email" class="text-sm font-medium text-brand-brown-dark">Email</label>
          <input id="id-email" name="email" type="email" value={identity.email}
            class="font-body text-sm rounded-sm border border-brand-cream-dark px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-brand-gold" />
        </div>

        {(['logo_url', 'hero_image_url'] as const).map((field) => (
          <div class="flex flex-col gap-1">
            <span class="text-sm font-medium text-brand-brown-dark">
              {field === 'logo_url' ? 'School Logo' : 'Hero Image'}
            </span>
            <div class="flex items-center gap-3 flex-wrap">
              <div id={`preview-${field}`} class="h-14 w-20 rounded-md border border-brand-cream-dark bg-brand-cream flex items-center justify-center overflow-hidden text-xl">
                {identity[field] ? <img src={identity[field]} alt="" class="h-full w-full object-cover" /> : '🖼️'}
              </div>
              <label class="text-xs font-medium px-3 py-1.5 rounded-sm border border-brand-cream-dark bg-white cursor-pointer hover:bg-brand-cream">
                Upload to Cloudinary
                <input type="file" accept="image/*" class="hidden" data-upload-field={field} />
              </label>
              <input type="hidden" id={`id-${field}`} name={field} value={identity[field]} />
            </div>
          </div>
        ))}

        <div class="flex items-center gap-3 pt-2">
          <button type="submit" class="bg-brand-gold text-shell-obsidian shadow-gold hover:brightness-105 text-sm px-4 py-2 rounded-sm font-medium">
            Save School Identity
          </button>
          <span id="identity-status" class="text-sm"></span>
        </div>
      </form>
    </Card>

    <Card title="Academic Calendar">
      <form id="calendar-form" class="flex flex-col gap-4">
        <div class="grid grid-cols-2 gap-4">
          <div class="flex flex-col gap-1">
            <label for="cal-session" class="text-sm font-medium text-brand-brown-dark">Current Session</label>
            <select id="cal-session" name="current_session"
              class="font-body text-sm rounded-sm border border-brand-cream-dark px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-brand-gold">
              {ALL_SESSIONS.map((s) => <option value={s} selected={s === calendar.current_session}>{s}</option>)}
            </select>
          </div>
          <div class="flex flex-col gap-1">
            <label for="cal-term" class="text-sm font-medium text-brand-brown-dark">Current Term</label>
            <select id="cal-term" name="current_term"
              class="font-body text-sm rounded-sm border border-brand-cream-dark px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-brand-gold">
              {['1st Term', '2nd Term', '3rd Term'].map((t) => <option selected={t === calendar.current_term}>{t}</option>)}
            </select>
          </div>
          <div class="flex flex-col gap-1">
            <label for="cal-termend" class="text-sm font-medium text-brand-brown-dark">Term Closes / School Closes Date</label>
            <input id="cal-termend" name="term_end_date" type="date" value={calendar.term_end_date}
              class="font-body text-sm rounded-sm border border-brand-cream-dark px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-brand-gold" />
          </div>
          <div class="flex flex-col gap-1">
            <label for="cal-nextterm" class="text-sm font-medium text-brand-brown-dark">Next Term Begins Date</label>
            <input id="cal-nextterm" name="next_term_date" type="date" value={calendar.next_term_date}
              class="font-body text-sm rounded-sm border border-brand-cream-dark px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-brand-gold" />
          </div>
          <div class="flex flex-col gap-1">
            <label for="cal-passmark" class="text-sm font-medium text-brand-brown-dark">Passing Mark (%)</label>
            <input id="cal-passmark" name="pass_mark" type="number" min="0" max="100" step="1" value={calendar.pass_mark} placeholder="e.g. 40"
              class="font-body text-sm rounded-sm border border-brand-cream-dark px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-brand-gold" />
            <p class="text-xs text-brand-brown-light mt-1">Students scoring at or above this mark are recorded as <strong>PASS</strong>; below it as <strong>FAIL</strong>, on student results, mark sheets, and the combined PDF.</p>
          </div>
        </div>
        <div class="flex items-center gap-3 pt-2">
          <button type="submit" class="bg-brand-gold text-shell-obsidian shadow-gold hover:brightness-105 text-sm px-4 py-2 rounded-sm font-medium">
            Save Academic Calendar
          </button>
          <span id="calendar-status" class="text-sm"></span>
        </div>
      </form>
    </Card>

    <Card title="School Brand Colours">
      <form id="colours-form" class="flex flex-col gap-4">
        <div class="flex gap-6 flex-wrap items-center">
          <div class="flex flex-col gap-1">
            <label for="col-primary" class="text-sm font-medium text-brand-brown-dark">Primary Colour</label>
            <div class="flex items-center gap-2">
              <input type="color" id="col-primary" name="primary_color" value={colours.primary_color} class="w-11 h-9 rounded-md border border-brand-cream-dark cursor-pointer" />
              <input type="text" id="col-primary-hex" value={colours.primary_color} class="w-24 font-body text-sm rounded-sm border border-brand-cream-dark px-2 py-2" />
            </div>
          </div>
          <div class="flex flex-col gap-1">
            <label for="col-secondary" class="text-sm font-medium text-brand-brown-dark">Background Colour</label>
            <div class="flex items-center gap-2">
              <input type="color" id="col-secondary" name="secondary_color" value={colours.secondary_color} class="w-11 h-9 rounded-md border border-brand-cream-dark cursor-pointer" />
              <input type="text" id="col-secondary-hex" value={colours.secondary_color} class="w-24 font-body text-sm rounded-sm border border-brand-cream-dark px-2 py-2" />
            </div>
          </div>
          <div id="colour-preview" class="px-5 py-3.5 rounded-md text-white text-sm font-semibold" style={`background:${colours.primary_color}`}>
            Preview — Buttons &amp; Accents
          </div>
        </div>
        <div class="flex items-center gap-3 pt-2">
          <button type="submit" class="bg-brand-gold text-shell-obsidian shadow-gold hover:brightness-105 text-sm px-4 py-2 rounded-sm font-medium">
            Save Brand Colours
          </button>
          <span id="colours-status" class="text-sm"></span>
        </div>
      </form>
    </Card>

    <Card title="Payment Gateways & Bank Info">
      <form class="simple-settings-form flex flex-col gap-4" data-status="paygw-status">
        <div class="flex flex-col gap-1">
          <label class="text-sm font-medium text-brand-brown-dark">Paystack Public Key</label>
          <input name="paystack_public_key" value={ss?.paystack_public_key || ''} placeholder="pk_live_xxxxxxxxxxxxxxxxxxxxxxxx"
            class="font-body text-sm rounded-sm border border-brand-cream-dark px-3 py-2 bg-white" />
          <p class="text-xs text-brand-brown-light">Secret key stays server-side (Supabase Vault / edge function) — never entered here.</p>
        </div>
        <div class="flex flex-col gap-1">
          <label class="text-sm font-medium text-brand-brown-dark">Remita Public Key</label>
          <input name="remita_public_key" value={ss?.remita_public_key || ''} placeholder="paste your Remita public key here"
            class="font-body text-sm rounded-sm border border-brand-cream-dark px-3 py-2 bg-white" />
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-brand-brown-dark">Bank Name</label>
            <input name="bank_name" value={ss?.bank_name || ''} placeholder="e.g. First Bank Nigeria"
              class="font-body text-sm rounded-sm border border-brand-cream-dark px-3 py-2 bg-white" />
          </div>
          <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-brand-brown-dark">Account Name</label>
            <input name="bank_account_name" value={ss?.bank_account_name || ''} placeholder="e.g. Victorious International Schools"
              class="font-body text-sm rounded-sm border border-brand-cream-dark px-3 py-2 bg-white" />
          </div>
          <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-brand-brown-dark">Account Number</label>
            <input name="bank_account_number" value={ss?.bank_account_number || ''} placeholder="e.g. 0123456789"
              class="font-body text-sm rounded-sm border border-brand-cream-dark px-3 py-2 bg-white" />
          </div>
          <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-brand-brown-dark">Payment Phone (cash/transfer)</label>
            <input name="payment_phone" value={ss?.payment_phone || ''} placeholder="e.g. 08012345678"
