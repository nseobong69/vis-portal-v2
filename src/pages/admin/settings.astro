              <div class="text-sm font-medium text-brand-brown-dark">{def.icon} Level {n}</div>
              <div class="grid grid-cols-2 gap-4">
                <input name={`acad_level_${n}_icon`} value={(ss as any)?.[`acad_level_${n}_icon`] || def.icon} placeholder={def.icon}
                  class="font-body text-sm rounded-sm border border-brand-cream-dark px-2 py-2 bg-white text-center" />
                <input name={`acad_level_${n}_title`} value={(ss as any)?.[`acad_level_${n}_title`] || def.title} placeholder={def.title}
                  class="font-body text-sm rounded-sm border border-brand-cream-dark px-2 py-2 bg-white" />
              </div>
              <textarea name={`acad_level_${n}_body`} rows="2" class="font-body text-sm rounded-sm border border-brand-cream-dark px-2 py-2 bg-white">{(ss as any)?.[`acad_level_${n}_body`] || def.body}</textarea>
            </div>
          );
        })}

        <div class="text-xs font-semibold text-brand-brown-dark uppercase tracking-wide">🏆 Academic Strengths (bullet list)</div>
        <p class="text-xs text-brand-brown-light -mt-2">One bullet point per line. Leave a line blank to hide it.</p>
        <div class="flex flex-col gap-1">
          <label class="text-sm font-medium text-brand-brown-dark">Strengths Section Title</label>
          <input name="acad_strengths_title" value={ss?.acad_strengths_title || 'Our Academic Strengths'} class="font-body text-sm rounded-sm border border-brand-cream-dark px-3 py-2 bg-white" />
        </div>
        {[1, 2, 3, 4, 5].map((n) => (
          <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-brand-brown-dark">Bullet {n}</label>
            <input name={`acad_strength_${n}`} value={(ss as any)?.[`acad_strength_${n}`] || academicStrengthDefaults[n - 1]} placeholder={academicStrengthDefaults[n - 1]}
              class="font-body text-sm rounded-sm border border-brand-cream-dark px-3 py-2 bg-white" />
          </div>
        ))}

        <div class="flex items-center gap-3 pt-2">
          <button type="submit" class="bg-brand-gold text-shell-obsidian shadow-gold hover:brightness-105 text-sm px-4 py-2 rounded-sm font-medium">
            Save Academics Page
          </button>
          <span id="acad-status" class="text-sm"></span>
        </div>
      </form>
    </Card>

    <Card title="About Us Page">
      <form class="simple-settings-form flex flex-col gap-4" data-status="about-status">
        <div class="flex flex-col gap-1">
          <label class="text-sm font-medium text-brand-brown-dark">Intro Paragraph</label>
          <textarea name="about_intro" rows="4" class="font-body text-sm rounded-sm border border-brand-cream-dark px-3 py-2 bg-white">{ss?.about_intro || 'We are a co-educational school located in Cross River State, Nigeria, nurturing learners from Crèche through Senior Secondary School. Our programme builds character, wisdom and academic excellence within a safe, values-centred environment.'}</textarea>
        </div>

        <div class="text-xs font-semibold text-brand-brown-dark uppercase tracking-wide">Core Values (shown as cards on the About page)</div>
        {[1, 2, 3, 4].map((n) => {
          const def = aboutValueDefaults[n - 1];
          return (
            <div class="border border-brand-cream-dark rounded-md p-3 bg-brand-cream flex flex-col gap-2">
              <div class="text-sm font-medium text-brand-brown-dark">{def.icon} Value {n}</div>
              <div class="grid grid-cols-2 gap-4">
                <input name={`about_val_${n}_icon`} value={(ss as any)?.[`about_val_${n}_icon`] || def.icon} placeholder={def.icon}
                  class="font-body text-sm rounded-sm border border-brand-cream-dark px-2 py-2 bg-white text-center" />
                <input name={`about_val_${n}_title`} value={(ss as any)?.[`about_val_${n}_title`] || def.title} placeholder={def.title}
                  class="font-body text-sm rounded-sm border border-brand-cream-dark px-2 py-2 bg-white" />
              </div>
              <textarea name={`about_val_${n}_body`} rows="2" class="font-body text-sm rounded-sm border border-brand-cream-dark px-2 py-2 bg-white">{(ss as any)?.[`about_val_${n}_body`] || def.body}</textarea>
            </div>
          );
        })}

        <div class="flex items-center gap-3 pt-2">
          <button type="submit" class="bg-brand-gold text-shell-obsidian shadow-gold hover:brightness-105 text-sm px-4 py-2 rounded-sm font-medium">
            Save About Us Page
          </button>
          <span id="about-status" class="text-sm"></span>
        </div>
      </form>
    </Card>
  </div>
</StaffLayout>

<script>
  // Vanilla-JS handlers for the static Identity form — this half of the
  // page has no repeatable/dynamic state, so it doesn't need a React
  // island (Section 3 note on attendance.astro applies the same logic
  // here: hydrate only what's actually interactive).
  async function uploadToCloudinary(file: File, folder: string): Promise<string> {
    const signRes = await fetch('/api/admin/settings/sign-upload', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ folder }),
    });
    const sig = await signRes.json();
    if (!signRes.ok || !sig?.signature) throw new Error(sig?.error || 'Upload signing failed.');

    const fd = new FormData();
    fd.append('file', file);
    fd.append('folder', sig.folder);
    fd.append('public_id', sig.public_id);
    fd.append('api_key', sig.api_key);
    fd.append('signature', sig.signature);
    fd.append('timestamp', String(sig.timestamp));

    const res = await fetch(`https://api.cloudinary.com/v1_1/${sig.cloud_name}/image/upload`, {
      method: 'POST',
      body: fd,
    });
    const data = await res.json();
    if (data.error) throw new Error(data.error.message);
    return data.secure_url as string;
  }

  document.querySelectorAll<HTMLInputElement>('input[data-upload-field]').forEach((input) => {
    input.addEventListener('change', async () => {
      const file = input.files?.[0];
      if (!file) return;
      const field = input.dataset.uploadField!;
      const folder = 'vis/school';
      const preview = document.getElementById(`preview-${field}`)!;
      const hidden = document.getElementById(`id-${field}`) as HTMLInputElement;
      preview.textContent = 'Uploading…';
      try {
        const url = await uploadToCloudinary(file, folder);
        hidden.value = url;
        preview.innerHTML = `<img src="${url}" alt="" class="h-full w-full object-cover">`;
      } catch (e) {
        preview.textContent = '🖼️';
        alert(e instanceof Error ? e.message : 'Upload failed.');
      } finally {
        input.value = '';
      }
    });
  });

  const form = document.getElementById('identity-form') as HTMLFormElement;
  const statusEl = document.getElementById('identity-status')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    statusEl.textContent = 'Saving…';
    statusEl.className = 'text-sm text-brand-brown-light';
    const fd = new FormData(form);
    const identity: Record<string, string> = {};
    ['school_name', 'motto', 'address', 'phone1', 'phone2', 'email', 'logo_url', 'hero_image_url'].forEach((k) => {
      identity[k] = (fd.get(k) as string) || '';
    });
    try {
      const res = await fetch('/api/admin/settings/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ fields: identity }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data?.error || 'Save failed.');
      statusEl.textContent = '✅ Saved.';
      statusEl.className = 'text-sm text-success-700';
    } catch (err) {
      statusEl.textContent = err instanceof Error ? err.message : 'Save failed.';
      statusEl.className = 'text-sm text-danger-700';
    }
  });

  // ── Academic Calendar ──
  const calForm = document.getElementById('calendar-form') as HTMLFormElement;
  const calStatus = document.getElementById('calendar-status')!;
  calForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    calStatus.textContent = 'Saving…';
    calStatus.className = 'text-sm text-brand-brown-light';
    const fd = new FormData(calForm);
    const calendar: Record<string, string | number> = {};
    ['current_session', 'current_term', 'term_end_date', 'next_term_date'].forEach((k) => {
      calendar[k] = (fd.get(k) as string) || '';
    });
    // Pass Mark — clamp 0-100 the same way saveSchoolSettings() does
    // (index.html line 17730), defaulting to 40 on anything invalid.
    const rawPassMark = parseFloat((fd.get('pass_mark') as string) || '');
    calendar.pass_mark = isNaN(rawPassMark) ? 40 : Math.max(0, Math.min(100, rawPassMark));
    try {
      const res = await fetch('/api/admin/settings/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ fields: calendar }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data?.error || 'Save failed.');
      calStatus.textContent = '✅ Saved.';
      calStatus.className = 'text-sm text-success-700';
    } catch (err) {
      calStatus.textContent = err instanceof Error ? err.message : 'Save failed.';
      calStatus.className = 'text-sm text-danger-700';
    }
  });

  // ── Brand Colours ──
  const priColor = document.getElementById('col-primary') as HTMLInputElement;
  const priHex = document.getElementById('col-primary-hex') as HTMLInputElement;
  const secColor = document.getElementById('col-secondary') as HTMLInputElement;
  const secHex = document.getElementById('col-secondary-hex') as HTMLInputElement;
  const preview = document.getElementById('colour-preview') as HTMLDivElement;

  function syncPreview() {
    preview.style.background = priColor.value;
  }
  priColor.addEventListener('input', () => { priHex.value = priColor.value; syncPreview(); });
  priHex.addEventListener('input', () => { priColor.value = priHex.value; syncPreview(); });
  secColor.addEventListener('input', () => { secHex.value = secColor.value; syncPreview(); });
  secHex.addEventListener('input', () => { secColor.value = secHex.value; syncPreview(); });

  const coloursForm = document.getElementById('colours-form') as HTMLFormElement;
  const coloursStatus = document.getElementById('colours-status')!;
  coloursForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    coloursStatus.textContent = 'Saving…';
    coloursStatus.className = 'text-sm text-brand-brown-light';
    try {
      const res = await fetch('/api/admin/settings/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          fields: { primary_color: priHex.value, secondary_color: secHex.value },
        }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data?.error || 'Save failed.');
      coloursStatus.textContent = '✅ Saved.';
      coloursStatus.className = 'text-sm text-success-700';
    } catch (err) {
      coloursStatus.textContent = err instanceof Error ? err.message : 'Save failed.';
      coloursStatus.className = 'text-sm text-danger-700';
    }
  });

  // ── Generic wiring for every plain field-group form (Payment Gateways,
  // Email Config, Admissions & Fees, Public Controls, Social Links, News
  // Header) — one handler instead of six near-identical copies. Each
  // form just needs named inputs/textareas/checkboxes and a
  // data-status="<id>" pointing at its status <span>.
  document.querySelectorAll<HTMLFormElement>('form.simple-settings-form').forEach((form) => {
    const statusEl = document.getElementById(form.dataset.status || '');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (statusEl) { statusEl.textContent = 'Saving…'; statusEl.className = 'text-sm text-brand-brown-light'; }
      const fields: Record<string, string | boolean> = {};
      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[name]').forEach((el) => {
        if (el instanceof HTMLInputElement && el.type === 'checkbox') {
          fields[el.name] = el.checked;
        } else {
          fields[el.name] = el.value;
        }
      });
      try {
        const res = await fetch('/api/admin/settings/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ fields }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data?.error || 'Save failed.');
        if (statusEl) { statusEl.textContent = '✅ Saved.'; statusEl.className = 'text-sm text-success-700'; }
      } catch (err) {
        if (statusEl) {
          statusEl.textContent = err instanceof Error ? err.message : 'Save failed.';
          statusEl.className = 'text-sm text-danger-700';
        }
      }
    });
  });

  // ── Admission Info Card (banner upload + fixed 5 steps + docs list) ──
  const admImgInput = document.getElementById('adm-card-img-input') as HTMLInputElement;
  admImgInput.addEventListener('change', async () => {
    const file = admImgInput.files?.[0];
    if (!file) return;
    const preview = document.getElementById('adm-card-img-preview')!;
    const hidden = document.getElementById('adm-card-img-hidden') as HTMLInputElement;
    preview.textContent = 'Uploading…';
    try {
      const url = await uploadToCloudinary(file, 'vis/school');
      hidden.value = url;
      preview.innerHTML = `<img src="${url}" alt="" class="h-full w-full object-cover">`;
    } catch (e) {
      preview.textContent = '🏫';
      alert(e instanceof Error ? e.message : 'Upload failed.');
    } finally {
      admImgInput.value = '';
    }
  });

  const admForm = document.getElementById('adm-card-form') as HTMLFormElement;
  const admStatus = document.getElementById('adm-card-status')!;
  admForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    admStatus.textContent = 'Saving…';
    admStatus.className = 'text-sm text-brand-brown-light';

    const steps = Array.from(admForm.querySelectorAll('.adm-step-icon')).map((iconEl, i) => ({
      icon: (iconEl as HTMLInputElement).value,
      title: (admForm.querySelectorAll('.adm-step-title')[i] as HTMLInputElement).value,
      body: (admForm.querySelectorAll('.adm-step-body')[i] as HTMLInputElement).value,
    }));
    const docs = (document.getElementById('adm-card-docs') as HTMLTextAreaElement).value
      .split('\n').map((d) => d.trim()).filter(Boolean);

    const fields = {
      adm_card_image_url: (document.getElementById('adm-card-img-hidden') as HTMLInputElement).value,
      adm_card_badge: (admForm.querySelector('[name=adm_card_badge]') as HTMLInputElement).value,
      adm_card_badge_show: (admForm.querySelector('[name=adm_card_badge_show]') as HTMLInputElement).checked,
      adm_card_intro: (admForm.querySelector('[name=adm_card_intro]') as HTMLTextAreaElement).value,
    };

    try {
      const res = await fetch('/api/admin/settings/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ fields, adm_card_steps: steps, adm_card_docs: docs }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data?.error || 'Save failed.');
      admStatus.textContent = '✅ Saved.';
      admStatus.className = 'text-sm text-success-700';
    } catch (err) {
      admStatus.textContent = err instanceof Error ? err.message : 'Save failed.';
      admStatus.className = 'text-sm text-danger-700';
    }
  });

  // ── Key Stats (fixed 3-item array, same pattern as adm-card-form's
  // step collection above — plain class-based querySelectorAll, no
  // React island needed for a fixed-count list with no images) ──
  const statsForm = document.getElementById('stats-form') as HTMLFormElement;
  const statsStatus = document.getElementById('stats-status')!;
  statsForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    statsStatus.textContent = 'Saving…';
    statsStatus.className = 'text-sm text-brand-brown-light';
    const stats = Array.from(statsForm.querySelectorAll('.stat-icon')).map((iconEl, i) => ({
      icon: (iconEl as HTMLInputElement).value,
      number: (statsForm.querySelectorAll('.stat-number')[i] as HTMLInputElement).value,
      suffix: (statsForm.querySelectorAll('.stat-suffix')[i] as HTMLInputElement).value,
      caption: (statsForm.querySelectorAll('.stat-caption')[i] as HTMLInputElement).value,
    }));
    try {
      const res = await fetch('/api/admin/settings/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ hp_stats: stats }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data?.error || 'Save failed.');
      statsStatus.textContent = '✅ Saved.';
      statsStatus.className = 'text-sm text-success-700';
    } catch (err) {
      statsStatus.textContent = err instanceof Error ? err.message : 'Save failed.';
      statsStatus.className = 'text-sm text-danger-700';
    }
  });
</script>
