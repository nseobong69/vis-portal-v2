---
// Admin Portal — Classes
// Replaces the earlier unverified stub. Ported from renderClasses()/
// showAddClassModal()/editClass()/deleteClass() (index.html ~7712-7789).
import AdminLayout from '../../layouts/AdminLayout.astro';
import ClassesManager from '../../components/admin/ClassesManager';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';

const auth = await checkAuth(Astro.cookies, [
  'super_admin', 'admin', 'proprietor', 'head_teacher', 'principal', 'teacher', 'subject_teacher', 'bursar',
]);
if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

const supabase = createServerSupabase(Astro.cookies);
const [{ data: classesData, error }, { data: teachers }] = await Promise.all([
  supabase.from('classes').select('*, profiles(full_name)').order('name'),
  supabase.from('profiles').select('id, full_name').order('full_name'),
]);

let classes = classesData || [];
// Same role-based scope as renderClasses() (index.html ~7718-7719).
if (auth.role === 'head_teacher') {
  classes = classes.filter((c) => ['kindergarten', 'nursery', 'primary'].includes((c.level || '').toLowerCase()));
} else if (auth.role === 'principal') {
  classes = classes.filter((c) => (c.level || '').toLowerCase() === 'secondary');
}
---
<AdminLayout title="Classes" activePath="/admin/classes" role={auth.role}>
  <div class="flex flex-col gap-4">
    <div>
      <h1 class="font-heading font-bold text-2xl text-brand-brown-dark">Classes</h1>
      <p class="text-sm text-brand-brown-light">Manage class groups</p>
    </div>

    {error && (
      <div class="bg-danger-700/10 border border-danger-700 text-danger-700 text-sm rounded-md p-3">
        Could not load classes: {error.message}
      </div>
    )}

    <ClassesManager client:load classes={classes as any} teachers={(teachers ?? []) as any} />
  </div>
</AdminLayout>
