---
// Admin Portal — Reception
// Full port: check-in/out actions wired through /api/admin/reception/action.
// Ported from renderReception() (index.html ~L20814-20916). Table: visitors.
// Gate-pass PDF is generated client-side (jsPDF) using school_settings
// for the header, same as the old downloadGatePass().
import AdminLayout from '../../layouts/AdminLayout.astro';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';
import ReceptionIsland from '../../components/admin/ReceptionIsland';

const auth = await checkAuth(Astro.cookies, ['super_admin', 'admin', 'proprietor', 'head_teacher', 'principal']);

if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

const supabase = createServerSupabase(Astro.cookies);
const [{ data: visitors }, { data: schoolSettings }] = await Promise.all([
  supabase.from('visitors').select('*').order('check_in_time', { ascending: false }).limit(200),
  supabase.from('school_settings').select('school_name, logo_url').eq('id', 1).single(),
]);
---
<AdminLayout title="Reception" activePath="/admin/reception" role={auth.role}>
  <ReceptionIsland
    client:load
    initialVisitors={(visitors ?? []) as any}
    schoolName={schoolSettings?.school_name || 'SCHOOL'}
    logoUrl={schoolSettings?.logo_url || null}
  />
</AdminLayout>
