---
// CORRECTED from the previous version of this file, which wired this
// route to ScoreSheetIsland — a read-only PDF-export tool with no
// input fields and no Save button. The actual "Results Entry" screen
// (renderResults()/loadSheet()/saveSheet()/calcPos() in the old app,
// index.html line 9348) is ResultsSheet.tsx: class/subject/term/session
// select, an editable CA/Exam grid, Save, Calc Positions, Block Results.
// That component's data layer was also broken (browser-side anon
// Supabase client returning empty under RLS) — fixed in
// src/lib/results.ts + src/pages/api/staff/results/action.ts, both
// part of this same push.
import AdminLayout from '../../layouts/AdminLayout.astro';
import { checkAuth } from '../../lib/auth';
import ResultsSheetIsland from '../../components/staff/ResultsSheetIsland';

const auth = await checkAuth(Astro.cookies, [
  'super_admin', 'admin', 'proprietor', 'head_teacher', 'principal',
]);
if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}
---
<AdminLayout title="Results" activePath="/admin/results" role={auth.role}>
  <div class="mb-6">
    <h1 class="font-heading font-extrabold text-2xl text-brand-brown-dark">Results Entry</h1>
    <p class="text-sm text-brand-brown-light mt-1">Enter and publish student results by class, subject, term and session.</p>
  </div>
  <ResultsSheetIsland client:load role={auth.role} userId={auth.userId} />
</AdminLayout>
