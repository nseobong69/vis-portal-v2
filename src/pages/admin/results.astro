---
// Replaces the raw-UUID stub. renderResults() in the old app
// (index.html line 9348) is the SAME feature for admin, teacher, and
// subject_teacher alike — Class/Subject/Term/Session → score sheet with
// CA/Exam/Total/Grade. That's already built correctly as
// ScoreSheet.tsx/ScoreSheetIsland.tsx for the staff routes, and its
// auth check already permits super_admin/admin. So this page just
// mounts that same component under AdminLayout instead of duplicating
// the logic — no new score-entry code, just correct reuse.
import AdminLayout from '../../layouts/AdminLayout.astro';
import { checkAuth } from '../../lib/auth';
import ScoreSheetIsland from '../../components/staff/ScoreSheetIsland';

const auth = await checkAuth(Astro.cookies, [
  'super_admin', 'admin', 'proprietor', 'head_teacher', 'principal',
]);
if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

// Same TODO the staff score-sheet.astro already carries — school_name
// isn't wired to a real settings table yet in this component.
const schoolName = 'Victorious International Schools';
---
<AdminLayout title="Results" activePath="/admin/results" role={auth.role}>
  <div class="mb-6">
    <h1 class="font-heading font-extrabold text-2xl text-brand-brown-dark">Results Entry</h1>
    <p class="text-sm text-brand-brown-light mt-1">Enter and review student scores by class, subject, term and session.</p>
  </div>
  <ScoreSheetIsland client:load role={auth.role} userId={auth.userId} schoolName={schoolName} />
</AdminLayout>
