---
// Admin Portal — Results Entry
// Entry form, Combined PDF, and report cards not ported. Score Sheet and Mark Sheet already exist as real staff-side screens from the ScoreSheet/MarkSheet phase — this row is the admin-tier oversight list only.
import AdminLayout from '../../layouts/AdminLayout.astro';
import Card from '../../components/ui/Card';
import Table from '../../components/ui/Table';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';

const auth = await checkAuth(Astro.cookies, ['super_admin', 'admin', 'proprietor', 'head_teacher', 'principal']);

if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

const supabase = createServerSupabase(Astro.cookies);
const { data: rows, error } = await supabase
  .from('results')
  .select('*')
  .limit(25);

const columns = [
  { key: 'student_id', header: 'Student' },
  { key: 'subject_id', header: 'Subject' },
  { key: 'score', header: 'Score' }
];
---
<AdminLayout title="Results Entry" activePath="/admin/results" role={auth.role}>
  <Card title="Results Entry">
    {error && (
      <p class="text-sm text-red-600 mb-3">
        Query against `results` failed — table/columns not verified against the live
        schema yet (same as-audited-not-verified caveat as Phase 0's table list).
      </p>
    )}
    <Table
      columns={columns}
      rows={(rows ?? []) as any[]}
      getRowKey={(row: any) => String(row.id ?? JSON.stringify(row))}
    />
  </Card>
</AdminLayout>
