---
// Admin Portal — Class Hub
// Overview index — links out to Students, Classes, Subjects, Staff below. Same table-of-tables landing pattern as the old app's Class Hub screen; the deep tab logic (Affective Traits, Publish Result, Clearance) already lives in staff/class-hub components from the Staff/Teacher Portal pass and is not re-derived here.
import AdminLayout from '../../layouts/AdminLayout.astro';
import Card from '../../components/ui/Card';
import Table from '../../components/ui/Table';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';

const auth = await checkAuth(Astro.cookies, ['super_admin', 'admin', 'proprietor', 'head_teacher', 'principal']);

if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

const supabase = createServerSupabase(Astro.cookies);
const { data: rows, error } = await supabase
  .from('classes')
  .select('*')
  .limit(25);

const columns = [
  { key: 'name', header: 'Class' },
  { key: 'arm', header: 'Arm' }
];
---
<AdminLayout title="Class Hub" activePath="/admin/class-hub" role={auth.role}>
  <Card title="Class Hub">
    {error && (
      <p class="text-sm text-red-600 mb-3">
        Query against `classes` failed — table/columns not verified against the live
        schema yet (same as-audited-not-verified caveat as Phase 0's table list).
      </p>
    )}
    <Table
      columns={columns}
      rows={(rows ?? []) as any[]}
      getRowKey={(row: any) => String(row.id ?? JSON.stringify(row))}
    />
  </Card>
</AdminLayout>
