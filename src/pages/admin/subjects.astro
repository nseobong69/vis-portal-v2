---
// Admin Portal — Subjects
// Replaces the earlier unverified stub. Ported from renderSubjects()/
// showAddSubjectModal()/addSubjectBulk()/assignSubjectToClass()/
// loadClassSubjects()/deleteSubject() (index.html ~7804-7901).
import AdminLayout from '../../layouts/AdminLayout.astro';
import SubjectsManager from '../../components/admin/SubjectsManager';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';

const auth = await checkAuth(Astro.cookies, ['super_admin', 'admin', 'proprietor', 'head_teacher', 'principal']);
if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

const supabase = createServerSupabase(Astro.cookies);
const [{ data: subjects, error }, { data: classes }] = await Promise.all([
  supabase.from('subjects').select('*').order('name'),
  supabase.from('classes').select('id, name, arm').order('name'),
]);

const classOptions = (classes || []).map((c) => ({ id: c.id, label: `${c.name}${c.arm ? ' ' + c.arm : ''}` }));
---
<AdminLayout title="Subjects" activePath="/admin/subjects" role={auth.role}>
  <div class="flex flex-col gap-4">
    <div>
      <h1 class="font-heading font-bold text-2xl text-brand-brown-dark">Subjects</h1>
      <p class="text-sm text-brand-brown-light">Manage subjects and assign to classes</p>
    </div>

    {error && (
      <div class="bg-danger-700/10 border border-danger-700 text-danger-700 text-sm rounded-md p-3">
        Could not load subjects: {error.message}
      </div>
    )}

    <SubjectsManager subjects={(subjects ?? []) as any} classes={classOptions} client:load />
  </div>
</AdminLayout>
