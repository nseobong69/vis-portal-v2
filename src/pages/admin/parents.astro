---
import AdminLayout from '../../layouts/AdminLayout.astro';
import ParentsIsland from '../../components/admin/ParentsIsland';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';

const ALLOWED_ROLES = ['super_admin', 'admin', 'proprietor', 'head_teacher', 'principal'];
const auth = await checkAuth(Astro.cookies, ALLOWED_ROLES);
if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

const supabase = createServerSupabase(Astro.cookies);

const [{ data: parents }, { data: students }] = await Promise.all([
  supabase.from('parents').select('*').order('full_name'),
  supabase.from('students').select('id, full_name, class_name').order('full_name'),
]);

const isSuperAdmin = ['super_admin', 'admin'].includes(auth.role);
---
<AdminLayout title="Parents" activePath="/admin/parents" role={auth.role}>
  <ParentsIsland
    client:load
    initialParents={(parents || []) as any}
    students={(students || []) as any}
    isSuperAdmin={isSuperAdmin}
  />
</AdminLayout>
