---
import { createBrowserSupabase } from '../lib/supabase';
const next = Astro.url.searchParams.get('next') ?? null;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Log in · VIS Portal</title>
</head>
<body style="font-family: sans-serif; max-width: 360px; margin: 60px auto; padding: 0 20px;">
  <h1>Log in</h1>
  <form id="login-form">
    <div style="margin-bottom: 12px;">
      <label for="identifier" style="display:block; font-size: 13px; margin-bottom: 4px;">Email or Admission Number</label>
      <input id="identifier" name="identifier" type="text" required style="width:100%; padding:8px; box-sizing:border-box;" />
      <p style="font-size: 11px; color: #777; margin: 4px 0 0;">Staff: use your email. Students: use your admission number (e.g. VIS/2026/AB12X).</p>
    </div>
    <div style="margin-bottom: 12px;">
      <label for="password" style="display:block; font-size: 13px; margin-bottom: 4px;">Password</label>
      <input id="password" name="password" type="password" required style="width:100%; padding:8px; box-sizing:border-box;" />
    </div>
    <button type="submit" style="width:100%; padding:10px; background:#111; color:#fff; border:none;">
      Log in
    </button>
    <p id="error" style="color:#b00; font-size: 13px; margin-top: 10px;"></p>
  </form>

  <script>
    import { createBrowserSupabase } from '../lib/supabase';

    const form = document.getElementById('login-form') as HTMLFormElement;
    const errorEl = document.getElementById('error') as HTMLParagraphElement;
    const params = new URLSearchParams(window.location.search);
    const next = params.get('next'); // may be null — see DEFAULTS below

    // NEW: role-based default landing pages, used only when the login
    // page was reached with no ?next= (i.e. someone navigated to /login
    // directly rather than being bounced here from a specific protected
    // page). Matches the route convention already established elsewhere
    // in this app (/staff/attendance, /parent/attendance, /student/
    // attendance, /admin/attendance all real) — NOT independently
    // verified that /staff/dashboard, /parent/dashboard and /student/
    // dashboard specifically exist as pages; confirm these three after
    // deploying and tell me if any of them 404, since this is inferred
    // from naming convention, not a direct file read.
    const DEFAULT_BY_ROLE: Record<string, string> = {
      student: '/student/dashboard',
      parent: '/parent/dashboard',
      teacher: '/staff/dashboard',
      subject_teacher: '/staff/dashboard',
    };
    const FALLBACK_DEFAULT = '/admin/dashboard'; // super_admin/admin/proprietor/head_teacher/principal/bursar

    // Same conversion as studentLogin() (index.html ~6059-6060): an
    // admission number has no '@', so if the identifier doesn't look
    // like an email, treat it as one and build the synthetic address
    // the same way the old app does. Staff continue to type a real
    // email and pass through unchanged.
    function resolveEmail(identifier: string): string {
      const raw = identifier.trim();
      if (raw.includes('@')) return raw.toLowerCase();
      const safeAdm = raw.replace(/[/\\\s]/g, '').toLowerCase();
      return `${safeAdm}@student.vis.school`;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.textContent = '';
      const identifier = (document.getElementById('identifier') as HTMLInputElement).value;
      const password = (document.getElementById('password') as HTMLInputElement).value;
      const email = resolveEmail(identifier);
      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password }),
        });
        const json = await res.json();
        if (!res.ok) {
          errorEl.textContent = json.error || 'Login failed.';
          return;
        }

        // Attach the session to the browser-side Supabase client so
        // subsequent createBrowserSupabase() calls (React islands) run as
        // this authenticated user instead of anonymously. supabase-js
        // persists this to localStorage by default, so it carries over
        // to every later page load automatically.
        if (json.session) {
          const supabase = createBrowserSupabase();
          await supabase.auth.setSession({
            access_token: json.session.access_token,
            refresh_token: json.session.refresh_token,
          });
        }

        // Validate that next is a relative path to prevent open-redirect
        // attacks (e.g. ?next=https://evil.com). If there's no ?next= at
        // all (or it's invalid), fall back to the role-appropriate
        // dashboard instead of always sending everyone to /admin —
        // that's the fix: previously this defaulted to /admin/dashboard
        // unconditionally, which bounced students/parents/teachers
        // straight into a 403 immediately after a successful login.
        const roleDefault = (json.role && DEFAULT_BY_ROLE[json.role]) || FALLBACK_DEFAULT;
        const safeNext = next && next.startsWith('/') ? next : roleDefault;
        window.location.href = safeNext;
      } catch {
        errorEl.textContent = 'Network error — could not reach the server.';
      }
    });
  </script>
</body>
</html>
