---
// Homepage — served directly at "/" (Astro file-based routing + Section
// 3's "real URL, server-rendered" requirement — view-source on a fresh
// load shows this exact markup, no client router involved).
//
// UPDATED: this page previously rendered fixed const arrays copied from
// index.html's old JS defaults (_HP_APART_DEFAULTS etc.) with a comment
// flagging "Phase 4/School Settings will make this editable" — that pass
// happens here. Every section below now fetches school_settings (id=1)
// server-side, same query pattern as admin/settings.astro, and falls
// back to the original hardcoded copy only when a field is empty —
// exactly the same default-fallback behavior settings.astro already
// uses when rendering the editor form.
//
// Sections:
//   1. Hero (#hp-hero)                     — CMS-driven: tag, headline,
//      sub, CTA labels, 3 stat boxes (hp_hero_* / hp_stats)
//   2. Story/Values (#hp-story-*)          — 4 value cards, CMS-driven
//      text (hp_story_*) + photos for cards 2-4 (card 1 has no photo,
//      matches old app's CSS-art treatment)
//   3. What Sets Us Apart (#hp-apart)      — CMS-driven (hp_apart_cards),
//      now including each card's image
//   4. Student Life tabs (#hp-student-life)— CMS-driven (hp_life_tabs),
//      now including each tab's image. Ported as a static grid — the old
//      app's interactive tab/accordion behavior is a client-side
//      enhancement, not required for feature parity.
//   5. News (#hp-news)                     — still a placeholder grid;
//      wiring to the live public_posts table + realtime subscription is
//      a separate pass (needs the real Supabase schema) — untouched here.
//   6. Leadership (#hp-leadership)         — CMS-driven (hp_leadership_cards),
//      hides itself when there are no cards, same as the old app.
//   7. Footer (#hp-footer)                 — brand/contact/nav columns +
//      social row now pull from school_settings; a social link only
//      renders if its URL is set, matching the old app's behavior of
//      hiding empty platforms.
//
// NOT included on this page — scoped to a separate pass since each is
// its own Feature Checklist row, not part of "homepage parity":
//   - Admissions form itself (showAdmissionPublic) — CTAs below link to
//     /admissions, which is not built yet.
//   - MFA/portal login flow.
//   - News feed live wiring (see note on section 5 above).
import PublicLayout from '../layouts/PublicLayout.astro';
import InfoRow from '../components/InfoRow.astro';
import Card from '../components/ui/Card';
import { createServerSupabase } from '../lib/supabase';

const supabase = createServerSupabase(Astro.cookies);
const { data: ss } = await supabase
  .from('school_settings')
  .select(`
    school_name, motto, address, phone1, phone2, email, logo_url, hero_image_url,
    hp_apart_cards,
    hp_leadership_cards, hp_leadership_heading, hp_leadership_subtitle,
    hp_life_tabs,
    hp_hero_tag, hp_hero_headline, hp_hero_sub, hp_hero_cta_primary, hp_hero_cta_secondary, hp_stats,
    hp_story_1_eyebrow, hp_story_1_heading, hp_story_1_body, hp_story_1_cta1, hp_story_1_cta2,
    hp_story_2_heading, hp_story_2_body, hp_story_wisdom,
    hp_story_3_heading, hp_story_3_body, hp_story_courage,
    hp_story_4_heading, hp_story_4_body, hp_story_compassion,
    hp_news_heading, hp_news_subtext,
    public_tagline, public_contact_visible, public_admission_btn, public_feed_visible,
    social_facebook, social_instagram, social_youtube, social_linkedin, social_twitter
  `)
  .eq('id', 1)
  .single();

// Small helper — every *_cards / *_stats / *_tabs column is stored as a
// JSON string (same defensive parse settings.astro uses for hp_apart_cards
// etc.), so centralize it instead of repeating the try/catch six times.
function parseJsonArray<T>(raw: unknown): T[] {
  try {
    const val = typeof raw === 'string' ? JSON.parse(raw) : raw;
    return Array.isArray(val) ? val : [];
  } catch {
    return [];
  }
}

const schoolName = ss?.school_name || 'Victorious International Schools';

// ── Hero + Stats ──
const hero = {
  tag: ss?.hp_hero_tag || 'Okpok-Ikpa Okoyong · Cross River State, Nigeria',
  headline: ss?.hp_hero_headline || 'Where young minds fuel global change.',
  sub: ss?.hp_hero_sub || 'From Nursery through Senior Secondary, Victorious International Schools shapes confident, curious, and compassionate citizens — rooted in community, ready for the world.',
  ctaPrimary: ss?.hp_hero_cta_primary || 'Admission',
  ctaSecondary: ss?.hp_hero_cta_secondary || 'Explore the School ↓',
};

let stats: Array<{ icon: string; number: string; suffix: string; caption: string }> =
  parseJsonArray(ss?.hp_stats);
if (!stats.length) {
  stats = [
    { icon: '👥', number: '25', suffix: '', caption: 'Average class size' },
    { icon: '🏫', number: '3', suffix: ' levels', caption: 'Nursery, Primary & Secondary' },
    { icon: '🌍', number: '100', suffix: '%', caption: "Committed to every child's growth" },
  ];
}

// ── Story / Values (4 fixed cards — 1 text-only + 3 with photos) ──
const values = [
  {
    eyebrow: ss?.hp_story_1_eyebrow || 'Our Purpose',
    title: ss?.hp_story_1_heading || 'Learning with purpose',
    body: ss?.hp_story_1_body || 'At Victorious International Schools, a world-class education cultivates critical thinking, creative problem-solving, and the essential qualities of global citizenship — rooted in the values of our community.',
    cta1: ss?.hp_story_1_cta1 || 'Explore Academics',
    cta2: ss?.hp_story_1_cta2 || 'Admissions & Aid',
    img: '',
  },
  {
    eyebrow: 'Wisdom',
    title: ss?.hp_story_2_heading || 'Peace through understanding',
    body: ss?.hp_story_2_body || 'We believe knowledge is most powerful when it is paired with humility. Our students learn to listen deeply, think critically, and lead with the wisdom that comes from diverse perspectives.',
    img: ss?.hp_story_wisdom || '',
  },
  {
    eyebrow: 'Courage',
    title: ss?.hp_story_3_heading || 'Strength through difference',
    body: ss?.hp_story_3_body || 'Courage means showing up fully — sharing ideas that challenge, standing for what is right, and finding boldness even when it is difficult. Our students learn that their unique voices are their greatest strength.',
    img: ss?.hp_story_courage || '',
  },
  {
    eyebrow: 'Compassion',
    title: ss?.hp_story_4_heading || 'Empathy in action',
    body: ss?.hp_story_4_body || 'Compassion is not a feeling alone — it is a choice we make every day. We nurture students who see the needs around them and respond with genuine care, building communities stronger than any individual.',
    img: ss?.hp_story_compassion || '',
  },
];

// ── What Sets Us Apart ──
// Source (fallback): window._HP_APART_DEFAULTS (index.html ~line 32095).
let apartCards: Array<{ icon: string; title: string; body: string; cta: string; img?: string }> =
  parseJsonArray(ss?.hp_apart_cards);
if (!apartCards.length) {
  apartCards = [
    { icon: '👥', title: 'Small classes, real connections',
      body: 'With small class sizes and dedicated teachers, every student gets personalised attention at every stage of their academic journey — no child is ever just a number here.', cta: 'Learn more' },
    { icon: '🌍', title: 'Rooted in community, built for growth',
      body: 'Located in Okpok-Ikpa Okoyong, Cross River State, our school blends strong academic foundations with the values of the community we serve — nurturing students from Nursery through Secondary in one connected campus.', cta: 'Our community' },
    { icon: '✨', title: 'Guided by experienced educators',
      body: "Our teachers bring years of classroom expertise and a genuine commitment to every child's progress — from foundational literacy to exam success, students are supported every step of the way.", cta: 'Meet our teachers' },
  ];
}

// ── Student Life tabs ──
// Source (fallback): desktop tab panel copy (index.html ~line 4577).
let studentLife: Array<{ icon: string; title: string; cta: string; body: string; img?: string }> =
  parseJsonArray(ss?.hp_life_tabs);
if (!studentLife.length) {
  studentLife = [
    { icon: '⚽', title: 'Athletics & Sports', cta: 'Join a Team',
      body: 'From the football pitch to the track field, our athletics programme keeps students active, resilient, and team-spirited. Students compete in inter-house and inter-school sports, building discipline and camaraderie every season.' },
    { icon: '🌟', title: 'Talents Hunt', cta: 'Discover Yours',
      body: "Our annual Talents Hunt gives every student a stage. Whether it's singing, spoken word, dance, drama, or comedy — students take centre stage and are celebrated for their unique gifts in front of the whole school community." },
    { icon: '🎭', title: 'Clubs & Activities', cta: 'Find Your Club',
      body: 'From the Debate Club and Press Club to the Literary and Science Clubs, students find their community in our wide range of extracurricular activities. Every club is student-led and faculty-supported, fostering leadership at every level.' },
    { icon: '🎯', title: 'Career Guidance', cta: 'Plan Your Future',
      body: "Our career counsellors walk alongside students from JSS1 through SS3, helping them identify strengths, explore professions, and make informed subject and tertiary choices — so every student leaves school knowing where they're headed." },
    { icon: '🎉', title: 'Celebrations & Events', cta: "See What's On",
      body: 'End-of-term parties, graduation ceremonies, cultural days, and prize-giving events — school life at VIS is filled with joyful moments that bring students, staff, and families together and build lasting memories.' },
  ];
}

// ── Leadership ──
// CMS-driven, defaults to empty in the old app too (no hardcoded
// fallback — see hpLoadLeadership, _HP_LEADERSHIP_DEFAULTS = []).
// Section hides itself when there are no cards, same as before.
const leadershipCards: Array<{ photo: string; name: string; position: string; bio: string }> =
  parseJsonArray(ss?.hp_leadership_cards);
const leadershipHeading = ss?.hp_leadership_heading || 'School Administration';
const leadershipSubtitle = ss?.hp_leadership_subtitle || 'The people guiding the school every day.';

// ── Footer / contact ──
const contactVisible = ss?.public_contact_visible !== false;
const admissionBtnVisible = ss?.public_admission_btn !== false;
const socialLinks = ([
  ['Facebook', ss?.social_facebook],
  ['Instagram', ss?.social_instagram],
  ['YouTube', ss?.social_youtube],
  ['LinkedIn', ss?.social_linkedin],
  ['X / Twitter', ss?.social_twitter],
] as const).filter(([, url]) => !!url);
---
<PublicLayout title="Home">
  <!-- ══ HERO ═══════════════════════════════════════════════════════
       hero_image_url (School Identity) renders as a full-bleed
       background with a dark gradient overlay so the existing text
       stays readable at the same contrast as the old solid-colour
       hero. No image set → falls back to the plain bg-shell-obsidian
       background exactly as before. ══════════════════════════════ -->
  <section
    class="relative bg-shell-obsidian text-shell-text px-6 py-20 md:py-28 bg-cover bg-center"
    style={ss?.hero_image_url ? `background-image:linear-gradient(rgba(10,10,15,.82),rgba(10,10,15,.88)),url('${ss.hero_image_url}')` : undefined}
  >
    <div class="max-w-[1400px] mx-auto">
      <p class="text-brand-gold text-xs uppercase tracking-widest mb-3">
        {hero.tag}
      </p>
      <p class="text-shell-muted text-sm mb-2">{schoolName}</p>
      {ss?.public_tagline && (
        <p class="text-shell-muted text-sm mb-2">{ss.public_tagline}</p>
      )}
      <h1 class="font-heading font-extrabold text-4xl md:text-6xl leading-tight mb-5 max-w-3xl">
        {hero.headline}
      </h1>
      <p class="text-shell-muted max-w-xl mb-8 text-base leading-relaxed">
        {hero.sub}
      </p>
      <div class="flex flex-wrap gap-3 mb-14">
        {admissionBtnVisible && (
          <a href="/admissions" class="bg-brand-gold text-shell-obsidian font-semibold px-6 py-3 rounded-md hover:brightness-105">
            {hero.ctaPrimary}
          </a>
        )}
        <a href="#news" class="border border-white/20 text-shell-text font-semibold px-6 py-3 rounded-md hover:bg-white/5">
          {hero.ctaSecondary}
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-2xl">
        {stats.map((s) => (
          <div class="flex items-center gap-3">
            <span class="text-2xl" aria-hidden="true">{s.icon}</span>
            <div>
              <div class="font-heading font-bold text-xl text-brand-gold">{s.number}{s.suffix}</div>
              <div class="text-xs text-shell-muted">{s.caption}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ VALUES / STORY ═════════════════════════════════════════════
       Source: index.html #hp-story-track, 4 cards. Card 1 has no photo
       (uses CSS art in the old app); cards 2-4 show a photo when set. ═ -->
  <section class="px-6 py-16 bg-brand-cream" aria-label="Learning with purpose — school values">
    <div class="max-w-[1000px] mx-auto grid gap-10">
      {values.map((v) => (
        <div class="border-b border-brand-cream-dark pb-8 last:border-b-0 last:pb-0 grid md:grid-cols-[1fr_auto] gap-6 items-start">
          <div>
            <p class="text-xs uppercase tracking-widest text-brand-gold-dark font-semibold mb-2">{v.eyebrow}</p>
            <h2 class="font-heading font-bold text-2xl text-brand-brown-dark mb-2">{v.title}</h2>
            <p class="text-brand-brown-light leading-relaxed max-w-2xl">{v.body}</p>
            {(v.cta1 || v.cta2) && (
              <div class="flex flex-wrap gap-4 mt-3 text-sm font-semibold text-brand-gold-dark">
                {v.cta1 && <span>{v.cta1} →</span>}
                {v.cta2 && <span>{v.cta2} →</span>}
              </div>
            )}
          </div>
          {v.img && (
            <img src={v.img} alt="" class="w-full md:w-[220px] h-[140px] object-cover rounded-md" />
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- ══ WHAT SETS US APART ═══════════════════════════════════════ -->
  <section class="px-6 py-16" aria-label={`What sets ${schoolName} apart`}>
    <div class="max-w-[1400px] mx-auto">
      <div class="text-center mb-10">
        <h2 class="font-heading font-extrabold text-3xl text-brand-brown-dark mb-2">What sets us apart</h2>
        <p class="text-brand-brown-light">Where every child is known, nurtured, and empowered to thrive.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {apartCards.map((c) => (
          <Card>
            {c.img && (
              <img src={c.img} alt="" class="w-full h-40 object-cover rounded-md mb-3" />
            )}
            <div class="text-3xl mb-3" aria-hidden="true">{c.icon}</div>
            <h3 class="font-heading font-bold text-lg text-brand-brown-dark mb-2">{c.title}</h3>
            <p class="text-sm text-brand-brown-light leading-relaxed mb-3">{c.body}</p>
            {c.cta && <span class="text-sm font-semibold text-brand-gold-dark">{c.cta} →</span>}
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ STUDENT LIFE ═══════════════════════════════════════════════
       Ported as a static grid (5 items, confirmed count). The old
       app's interactive tabs/accordion are a UX enhancement, not a
       feature-parity requirement. A standalone /student-life page
       already exists if that's the direction wanted instead of/
       alongside this section. ══════════════════════════════════════ -->
  <section class="px-6 py-16 bg-brand-cream" aria-label="Student life at Victorious International Schools">
    <div class="max-w-[1400px] mx-auto">
      <div class="text-center mb-10">
        <h2 class="font-heading font-extrabold text-3xl text-brand-brown-dark mb-2">Student Life</h2>
        <p class="text-brand-brown-light">
          Life beyond the classroom — see the <a href="/student-life" class="underline text-brand-gold-dark">full Student Life page</a>.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-5">
        {studentLife.map((s) => (
          <Card>
            {s.img && (
              <img src={s.img} alt="" class="w-full h-24 object-cover rounded-md mb-2" />
            )}
            <div class="text-2xl mb-2" aria-hidden="true">{s.icon}</div>
            <h3 class="font-heading font-bold text-sm text-brand-brown-dark mb-1.5">{s.title}</h3>
            <p class="text-xs text-brand-brown-light leading-relaxed mb-2">{s.body}</p>
            {s.cta && <span class="text-xs font-semibold text-brand-gold-dark">{s.cta} →</span>}
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ NEWS ═══════════════════════════════════════════════════════
       TODO (separate pass, not done here): wire to the live public_posts
       table with a realtime subscription (hpLoadNews() + Supabase
       postgres_changes channel in the old app). This scaffold still has
       no Supabase query built against that table yet, so it stays a
       static placeholder, not a silent drop. Heading/subtext now come
       from school_settings; the toggle below matches public_feed_visible. ═ -->
  {ss?.public_feed_visible !== false && (
    <section id="news" class="px-6 py-16" aria-label="School news">
      <div class="max-w-[1400px] mx-auto">
        <div class="flex items-baseline justify-between mb-8 flex-wrap gap-2">
          <h2 class="font-heading font-extrabold text-3xl text-brand-brown-dark">{ss?.hp_news_heading || 'School News'}</h2>
          <p class="text-brand-brown-light text-sm">{ss?.hp_news_subtext || 'Stories about the people, ideas, and events shaping our school community.'}</p>
        </div>
        <p class="text-sm text-brand-brown-light italic mb-4">
          Live news feed (from <code class="font-mono text-xs bg-brand-cream px-1 py-0.5 rounded">public_posts</code>)
          is not wired up in this pass.
        </p>
        <!--
          Ad slot between news items, carried over from index.html
          (data-pp-ad="between-*"). Same publisher ID; slot ID is the old
          app's own placeholder ("0000000000") — confirm/replace before
          enabling ads live.
        -->
        <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-7485758874129054" data-ad-slot="0000000000" data-ad-format="fluid" data-ad-layout-key="-fb+5w+4e-db+86"></ins>
      </div>
    </section>
  )}

  <!-- ══ LEADERSHIP ═══════════════════════════════════════════════
       CMS-driven, hides itself when there are no cards (matches the
       old app's own empty-state behavior). ═══════════════════════ -->
  {leadershipCards.length > 0 && (
    <section class="px-6 py-16 bg-brand-cream" aria-label="Meet our leadership">
      <div class="max-w-[1400px] mx-auto">
        <div class="text-center mb-10">
          <h2 class="font-heading font-extrabold text-3xl text-brand-brown-dark mb-2">{leadershipHeading}</h2>
          <p class="text-brand-brown-light">{leadershipSubtitle}</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {leadershipCards.map((p) => (
            <Card>
              {p.photo ? (
                <img src={p.photo} alt="" class="w-full h-40 object-cover rounded-md mb-3" />
              ) : (
                <div class="w-full h-40 rounded-md mb-3 bg-brand-cream-dark flex items-center justify-center text-3xl">🧑‍🏫</div>
              )}
              <h3 class="font-heading font-bold text-base text-brand-brown-dark mb-1">{p.name}</h3>
              <p class="text-xs font-semibold text-brand-gold-dark mb-2">{p.position}</p>
              <p class="text-sm text-brand-brown-light leading-relaxed">{p.bio}</p>
            </Card>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ══ FOOTER ═══════════════════════════════════════════════════ -->
  <footer class="bg-shell-obsidian text-shell-text px-6 py-14">
    <div class="max-w-[1400px] mx-auto grid md:grid-cols-4 gap-10">
      <div>
        <div class="font-heading font-bold text-brand-gold mb-1">{schoolName}</div>
        {ss?.motto && <p class="text-xs text-shell-muted mb-4">{ss.motto}</p>}
        <p class="text-sm text-shell-muted mb-4 max-w-xs">
          Nurturing minds and building character in Okoyong, Cross River State — from Nursery through Secondary School.
        </p>
        {contactVisible && (
          <address class="not-italic text-sm text-shell-muted space-y-1.5">
            <div>{ss?.address || 'Okpok-Ikpa Okoyong, Odukpani LGA, Cross River State, Nigeria'}</div>
            {ss?.phone1 && <div><a href={`tel:${ss.phone1}`} class="hover:text-brand-gold">{ss.phone1}</a></div>}
            {ss?.email && <div><a href={`mailto:${ss.email}`} class="hover:text-brand-gold">{ss.email}</a></div>}
          </address>
        )}
      </div>
      <nav aria-label="Explore links">
        <span class="text-xs uppercase tracking-wide text-shell-muted block mb-3">Explore</span>
        <ul class="space-y-2 text-sm">
          <li><a href="/about" class="hover:text-brand-gold">About Us</a></li>
          <li><a href="/academics-overview" class="hover:text-brand-gold">Academics</a></li>
          <li><a href="/student-life" class="hover:text-brand-gold">Student Life</a></li>
          <li><a href="#" class="hover:text-brand-gold">Our Approach</a></li>
          <li><a href="#news" class="hover:text-brand-gold">Campus News</a></li>
        </ul>
      </nav>
      <nav aria-label="Admissions and portal links">
        <span class="text-xs uppercase tracking-wide text-shell-muted block mb-3">Admissions</span>
        <ul class="space-y-2 text-sm">
          <li><a href="/admissions" class="hover:text-brand-gold">Admissions</a></li>
          <li><a href="/admissions" class="hover:text-brand-gold">Requirements</a></li>
          <li><a href="/admissions" class="hover:text-brand-gold">Tuition &amp; Fees</a></li>
          <li><a href="/login" class="hover:text-brand-gold">School Portal</a></li>
          <li><a href="/cbt-info" class="hover:text-brand-gold">CBT Exam</a></li>
        </ul>
      </nav>
      <div>
        <span class="text-xs uppercase tracking-wide text-shell-muted block mb-3">Follow us</span>
        {socialLinks.length > 0 ? (
          <div class="flex gap-3 text-shell-muted text-sm flex-wrap">
            {socialLinks.map(([label, url]) => (
              <a href={url} target="_blank" rel="noopener noreferrer" class="hover:text-brand-gold">{label}</a>
            ))}
          </div>
        ) : (
          <p class="text-xs text-shell-muted">Links coming soon.</p>
        )}
      </div>
    </div>
    <div class="max-w-[1400px] mx-auto border-t border-white/10 mt-10 pt-6 flex flex-wrap justify-between gap-3 text-xs text-shell-muted">
      <p>&copy; 2026 {schoolName}. All Rights Reserved.</p>
      <div class="flex gap-3">
        <span>Privacy Policy</span>
        <span>·</span>
        <span>Terms of Use</span>
      </div>
    </div>
  </footer>
</PublicLayout>
