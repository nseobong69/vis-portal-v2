---
import StudentLayout from '../../layouts/StudentLayout.astro';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';

const auth = await checkAuth(Astro.cookies, ['student']);
if (auth.status === 'unauthenticated') return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
if (auth.status === 'unauthorized') return Astro.redirect('/403');

const supabase = createServerSupabase(Astro.cookies);
const { data: student } = await supabase.from('students').select('id, full_name, class_id, class_name').eq('auth_id', auth.userId).maybeSingle();

const { data: exams } = student?.class_id
  ? await supabase.from('cbt_exams').select('id, title, subject_name, duration_minutes, available_from, available_until, status, exam_type').eq('class_id', student.class_id).eq('status', 'active').order('created_at', { ascending: false })
  : { data: [] };

const { data: codes } = student?.id
  ? await supabase.from('cbt_student_codes').select('code, exam_id, status').eq('student_id', student.id).eq('status', 'active')
  : { data: [] };

const codeMap: Record<string, string> = {};
for (const c of codes ?? []) codeMap[c.exam_id] = c.code;

function fmtDT(d?: string) {
  if (!d) return '';
  return new Date(d).toLocaleString('en-GB', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
}
---
<StudentLayout title="My Exams" activePath="/student/exams">
  <div class="flex flex-col gap-4">
    <div>
      <h1 class="font-heading font-bold text-xl text-brand-brown-dark">My Exams</h1>
      <p class="text-xs text-brand-brown-light">{student?.full_name} · {student?.class_name}</p>
    </div>

    {!exams?.length ? (
      <div class="bg-white rounded-md border border-brand-cream-dark p-10 text-center text-brand-brown-light">No active exams at the moment.</div>
    ) : (
      <div class="flex flex-col gap-3">
        {exams.map((e: any) => {
          const code = codeMap[e.id];
          return (
            <div class="bg-white rounded-md border border-brand-cream-dark p-5">
              <div class="flex justify-between items-start gap-2 mb-3">
                <div>
                  <div class="font-bold text-brand-brown-dark">{e.title}</div>
                  <div class="text-xs text-brand-brown-light">{e.subject_name} · {e.duration_minutes} mins</div>
                  {e.available_from && <div class="text-xs text-brand-brown-light mt-0.5">Available: {fmtDT(e.available_from)} – {fmtDT(e.available_until)}</div>}
                </div>
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-success-700/10 text-success-700 uppercase">Active</span>
              </div>
              {code ? (
                <div class="flex items-center justify-between gap-3 rounded-lg p-3" style="background:#F5EDE3;">
                  <div class="text-xs text-brand-brown-light">Your Access Code</div>
                  <code class="text-lg font-extrabold tracking-widest bg-white px-3 py-1 rounded-lg border-2 border-brand-brown-dark text-brand-brown-dark">{code}</code>
                </div>
              ) : (
                <a href={`/student/cbt/take?exam=${e.id}`} class="block text-center py-2.5 rounded-md bg-brand-brown-dark text-white text-sm font-semibold hover:brightness-110">
                  Start Exam →
                </a>
              )}
              <div class="text-[10.5px] text-danger-700 mt-2 text-center font-semibold">⚠️ Your access code is personal — do NOT share it.</div>
            </div>
          );
        })}
      </div>
    )}
  </div>
</StudentLayout>
