---
// Ported field-by-field from renderStudentDash() (index.html
// ~L7610-7701). Previously a minimal placeholder — this pass adds the
// three sections that were genuinely missing: live Fee Status, Notice
// Board (with upcoming active exams pinned above announcements), and
// My Exam Access Codes.
//
// FIXED: the old app itself used two different column names for the
// same concept (available_from/available_until in one query,
// start_at/end_at in another) and an earlier pass here carried that
// inconsistency forward verbatim without checking it against the real
// schema. Confirmed against the actual cbt_exams table: only
// start_at/end_at exist. Both queries below now use those consistently,
// and the separate cbt_student_codes table (also never confirmed to
// exist) was dropped in favor of the real access_code column that's
// already directly on cbt_exams.
import StudentLayout from '../../layouts/StudentLayout.astro';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';

const auth = await checkAuth(Astro.cookies, ['student']);
if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

const supabase = createServerSupabase(Astro.cookies);
const { data: student } = await supabase
  .from('students')
  .select('id, full_name, admission_number, class_name, class_id, avatar_url')
  .eq('auth_id', auth.userId)
  .maybeSingle();

const firstName = (student?.full_name || 'Student').trim().split(' ')[0];
const hr = new Date().getHours();
const greeting = hr < 12 ? 'Good morning' : hr < 17 ? 'Good afternoon' : 'Good evening';

// -- Fee Status (index.html ~L7638-7655) --
const { data: ssRow } = await supabase.from('school_settings').select('current_session').eq('id', 1).maybeSingle();
const session = ssRow?.current_session || '';

let feeLabel = 'No Invoice', feeColor = '#6B7280', feeBg = '#F9FAFB';
if (student?.id) {
  const { data: feeRows } = await supabase
    .from('fee_payments').select('status, amount, amount_paid')
    .eq('student_id', student.id).eq('session', session);
  if (feeRows && feeRows.length) {
    const allPaid = feeRows.every((r) => r.status === 'paid');
    const anyPartial = feeRows.some((r) => r.status === 'partial' || r.status === 'paid');
    if (allPaid) { feeLabel = 'Cleared'; feeColor = '#16A34A'; feeBg = '#DCFCE7'; }
    else if (anyPartial) { feeLabel = 'Partial'; feeColor = '#D97706'; feeBg = '#FEF3C7'; }
    else { feeLabel = 'Pending'; feeColor = '#EF4444'; feeBg = '#FEE2E2'; }
  }
}

// -- Notice Board + upcoming exams (index.html ~L7658-7671) --
// FIXED: available_from/available_until don't exist on cbt_exams
// (confirmed schema has start_at/end_at only) — this query failed
// outright before. Also dropped the cbt_student_codes join below;
// that table is unconfirmed to exist, and this app's real CBT build
// uses a single access_code column directly on cbt_exams instead.
const [{ data: notices }, { data: myExams }] = await Promise.all([
  supabase.from('announcements').select('title, body, created_at').order('created_at', { ascending: false }).limit(5),
  student?.class_id
    ? supabase.from('cbt_exams')
        .select('id, title, subject_name, class_name, duration_minutes, start_at, end_at, status, access_code')
        .eq('class_id', student.class_id).eq('status', 'active')
        .order('created_at', { ascending: false }).limit(5)
    : Promise.resolve({ data: [] as any[] }),
]);

// -- My Exam Access Codes (index.html ~L7674-7695) --
// FIXED: same access_code column as above, no separate codes table.
const examCodes = (myExams || []).filter((e: any) => e.access_code);

function fmtDT(d?: string) {
  if (!d) return '';
  return new Date(d).toLocaleString('en-GB', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
}
---
<StudentLayout title="Dashboard" activePath="/student/dashboard">
  <div class="flex flex-col gap-6">
    <div class="rounded-2xl p-6 text-white flex items-center gap-4" style="background:linear-gradient(135deg,#5D4037,#8D6E63);">
      {student?.avatar_url ? (
        <img src={student.avatar_url} class="w-14 h-14 rounded-2xl object-cover" alt="" />
      ) : (
        <div class="w-14 h-14 rounded-2xl bg-white/20 flex items-center justify-center text-xl font-bold">
          {firstName.charAt(0).toUpperCase()}
        </div>
      )}
      <div>
        <div class="text-lg font-bold">{greeting}, {firstName} 👋</div>
        <div class="text-sm opacity-80">Admission: {student?.admission_number || '—'} · Class: {student?.class_name || '—'}</div>
      </div>
    </div>

    <div class="grid gap-3.5" style="grid-template-columns:repeat(auto-fit,minmax(170px,1fr));">
      <div class="bg-white rounded-lg border-l-4 shadow-sm p-4" style={`border-left-color:#5D4037`}>
        <div class="text-xs font-semibold text-brand-brown-light">My Class</div>
        <div class="text-lg font-bold text-brand-brown-dark mt-1">{student?.class_name || '—'}</div>
      </div>
      <div class="bg-white rounded-lg border-l-4 shadow-sm p-4" style={`border-left-color:${feeColor}`}>
        <div class="text-xs font-semibold text-brand-brown-light">Fee Status</div>
        <div class="text-lg font-bold mt-1" style={`color:${feeColor}`}>{feeLabel}</div>
      </div>
    </div>

    <div class="grid gap-3.5" style="grid-template-columns:1fr 1fr;">
      <div class="bg-white rounded-lg shadow-sm p-5">
        <div class="font-bold text-sm text-brand-brown-dark mb-3">Quick Access</div>
        <div class="flex flex-col gap-2">
          <a href="/student/results" class="text-center text-sm font-semibold px-3 py-2.5 rounded-md bg-brand-brown-dark text-white hover:brightness-110">📖 My Results</a>
          <a href="/student/academics" class="text-center text-sm font-semibold px-3 py-2.5 rounded-md border border-brand-cream-dark hover:bg-brand-cream">🎓 Academics</a>
          <a href="/student/exams" class="text-center text-sm font-semibold px-3 py-2.5 rounded-md border border-brand-cream-dark hover:bg-brand-cream">💻 Take Exam</a>
          <a href="/student/fees" class="text-center text-sm font-semibold px-3 py-2.5 rounded-md border border-brand-cream-dark hover:bg-brand-cream">💰 Pay Fees</a>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow-sm p-5">
        <div class="font-bold text-sm text-brand-brown-dark mb-3">Notice Board</div>
        {myExams && myExams.length > 0 && (
          <div class="rounded-md p-3 mb-2" style="background:#FEF3C7;">
            <div class="font-bold text-xs mb-1.5" style="color:#92400E;">💻 Upcoming Exams</div>
            {myExams.map((e: any) => (
              <div class="py-1.5 border-b" style="border-color:#FDE68A;">
                <div class="font-semibold text-xs" style="color:#92400E;">{e.subject_name || e.title}</div>
                <div class="text-[11px]" style="color:#D97706;">
                  {e.duration_minutes} mins{e.start_at ? ` · From: ${fmtDT(e.start_at)}` : ''}
                </div>
              </div>
            ))}
          </div>
        )}
        {notices && notices.length > 0 ? (
          notices.map((a) => (
            <div class="text-xs text-brand-brown-light py-1.5 border-b border-brand-cream-dark last:border-0">📢 {a.title}</div>
          ))
        ) : (
          !myExams?.length && <p class="text-xs text-brand-brown-light">No notices.</p>
        )}
      </div>
    </div>

    {examCodes.length > 0 && (
      <div class="bg-white rounded-lg shadow-sm p-5">
        <div class="font-bold text-sm text-brand-brown-dark mb-3">🔑 My Exam Access Codes</div>
        <div class="flex flex-col gap-2">
          {examCodes.map((e: any) => (
            <div class="flex justify-between items-center flex-wrap gap-2 rounded-lg p-3.5" style="background:#F5EDE3;">
              <div>
                <div class="font-bold text-sm text-brand-brown-dark">{e.title || 'Exam'}</div>
                <div class="text-[11.5px] text-brand-brown-light">
                  {e.subject_name || '—'}{e.start_at ? ` · ${fmtDT(e.start_at)}` : ''}
                </div>
              </div>
              <div class="flex flex-col items-end gap-1">
                <code class="text-lg font-extrabold tracking-widest bg-white px-3 py-1 rounded-lg border-2 border-brand-brown-dark text-brand-brown-dark">{e.access_code}</code>
                <div class="text-[10px] font-semibold text-danger-700">⚠️ Personal — Do NOT share</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <div class="grid gap-3.5" style="grid-template-columns:repeat(auto-fit,minmax(160px,1fr));">
      <a href="/student/attendance" class="bg-white rounded-lg border border-brand-cream-dark shadow-sm p-5 hover:bg-brand-cream transition-colors">
        <div class="text-2xl mb-2">📅</div>
        <div class="font-bold text-brand-brown-dark">Attendance</div>
      </a>
      <a href="/student/profile" class="bg-white rounded-lg border border-brand-cream-dark shadow-sm p-5 hover:bg-brand-cream transition-colors">
        <div class="text-2xl mb-2">👤</div>
        <div class="font-bold text-brand-brown-dark">Profile</div>
      </a>
    </div>
  </div>
</StudentLayout>
