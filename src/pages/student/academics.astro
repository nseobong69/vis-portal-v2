---
import StudentLayout from '../../layouts/StudentLayout.astro';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';

const auth = await checkAuth(Astro.cookies, ['student']);
if (auth.status === 'unauthenticated') return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
if (auth.status === 'unauthorized') return Astro.redirect('/403');

const supabase = createServerSupabase(Astro.cookies);
const { data: student } = await supabase.from('students').select('id, full_name, class_id, class_name').eq('auth_id', auth.userId).maybeSingle();

// FIX: this was querying `academic_assignments.body/due_date` and a
// table called `lesson_notes` — neither matches what the admin
// Academics builder (AcademicsManager.tsx/action.ts) actually writes:
// assignments save as `content`/`submission_date`, and notes live in
// `academic_notes`, not `lesson_notes`. A teacher creating a real
// assignment or note could never show up here before this fix — wrong
// table for notes, wrong column names for assignment body/due date.
const [{ data: assignments }, { data: notes }] = await Promise.all([
  student?.class_id
    ? supabase.from('academic_assignments').select('id, title, content, submission_date, subject_name, created_at').eq('class_id', student.class_id).order('created_at', { ascending: false }).limit(20)
    : Promise.resolve({ data: [] as any[] }),
  student?.class_id
    ? supabase.from('academic_notes').select('id, title, subject_name, content, created_at').eq('class_id', student.class_id).order('created_at', { ascending: false }).limit(10)
    : Promise.resolve({ data: [] as any[] }),
]);

function fmtDate(d: string) { return new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }); }
---
<StudentLayout title="Academics" activePath="/student/academics">
  <div class="flex flex-col gap-5">
    <div>
      <h1 class="font-heading font-bold text-xl text-brand-brown-dark">Academics</h1>
      <p class="text-xs text-brand-brown-light">{student?.full_name} · {student?.class_name}</p>
    </div>

    <!-- Assignments -->
    <div class="flex flex-col gap-2">
      <div class="font-heading font-bold text-sm text-brand-brown-dark">📝 Assignments</div>
      {!assignments?.length ? (
        <div class="bg-white rounded-md border border-brand-cream-dark p-6 text-center text-brand-brown-light text-sm">No assignments yet.</div>
      ) : (
        <div class="flex flex-col gap-2">
          {assignments.map((a: any) => (
            <div class="bg-white rounded-md border border-brand-cream-dark p-4">
              <div class="flex justify-between items-start gap-2 mb-1">
                <div class="font-semibold text-sm text-brand-brown-dark">{a.title}</div>
                {a.submission_date && (
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-brand-cream text-brand-brown-dark shrink-0">
                    Due: {fmtDate(a.submission_date)}
                  </span>
                )}
              </div>
              {a.subject_name && <div class="text-xs text-brand-brown-light mb-1">{a.subject_name}</div>}
              {a.content && <div class="text-sm text-body leading-relaxed">{a.content}</div>}
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- Lesson Notes -->
    <div class="flex flex-col gap-2">
      <div class="font-heading font-bold text-sm text-brand-brown-dark">📖 Lesson Notes</div>
      {!notes?.length ? (
        <div class="bg-white rounded-md border border-brand-cream-dark p-6 text-center text-brand-brown-light text-sm">No lesson notes yet.</div>
      ) : (
        <div class="flex flex-col gap-2">
          {notes.map((n: any) => (
            <div class="bg-white rounded-md border border-brand-cream-dark p-4">
              <div class="flex justify-between items-start gap-2 mb-1">
                <div class="font-semibold text-sm text-brand-brown-dark">{n.title}</div>
                <div class="text-[11px] text-brand-brown-light shrink-0">{fmtDate(n.created_at)}</div>
              </div>
              {n.subject_name && <div class="text-xs text-brand-brown-light mb-2">{n.subject_name}</div>}
              {n.content && <div class="text-sm text-body leading-relaxed line-clamp-3">{n.content}</div>}
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</StudentLayout>
