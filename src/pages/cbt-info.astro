---
// Real route at /cbt-info. Old app used /cbt-exams as its pushState-only
// URL for this modal (showCBTInfoPage()); named /cbt-info here to match
// what Section 3 of the Project Prompt/Phase 0 doc called it — confirm
// which URL you actually want before Phase 3 is marked done for this row.
import PublicLayout from '../layouts/PublicLayout.astro';
import InfoRow from '../components/InfoRow.astro';

const steps = [
  { icon: '📩', title: '1. Receive Your Access Code',
    body: "After completing admission registration, your personal exam access code is sent to the parent's registered email address." },
  { icon: '🔐', title: '2. Log In with Your Admission Number',
    body: 'Enter your admission number and the access code you received. Both are required to enter the exam room.' },
  { icon: '⏱️', title: '3. Take the Timed Exam',
    body: 'Questions are displayed one at a time with a live countdown timer. Submit before time runs out to record your answers.' },
  { icon: '📊', title: '4. Instant Score Report',
    body: 'Your score is calculated automatically and submitted directly to the school immediately after the exam ends.' },
];
---
<PublicLayout title="CBT Exams" description="Computer-based testing at Victorious International Schools.">
  <div class="max-w-[680px] mx-auto px-5 py-12">
    <span class="inline-block bg-brand-brown text-white text-xs font-bold tracking-wide px-3 py-1 rounded-pill mb-3">
      COMPUTER-BASED TESTING
    </span>
    <h1 class="font-heading font-extrabold text-3xl text-brand-brown-dark mb-3">CBT Examinations at VIS</h1>
    <p class="text-brand-brown-light leading-relaxed mb-8">
      Victorious International Schools uses a secure Computer-Based Testing system for
      entrance aptitude assessments and scheduled examinations. All exams are timed,
      auto-marked, and submitted directly to the school — giving fair, instant results
      for every candidate.
    </p>

    <h2 class="font-heading font-bold text-xs uppercase tracking-wide text-brand-brown mb-2">
      How It Works
    </h2>
    <div class="border border-brand-cream-dark rounded-lg px-4 mb-6">
      {steps.map((s) => <InfoRow icon={s.icon} title={s.title} body={s.body} />)}
    </div>

    <div class="bg-warning-soft border-l-4 border-warning-700 rounded-md px-4 py-3">
      <p class="text-sm font-bold text-warning-700 mb-1">💡 Need your access code?</p>
      <p class="text-sm text-warning-700">
        Contact the school office with your admission number and they will resend your
        exam access code to your registered email.
      </p>
    </div>

    <div class="flex gap-3 mt-8 flex-wrap">
      <!-- TODO(Phase 3 continuation): wire to the real CBT public login route once built. -->
      <a href="/login" class="flex-1 min-w-[180px] text-center bg-brand-brown text-white font-semibold py-3.5 rounded-md hover:bg-brand-brown-dark">
        💻 Enter CBT Exam →
      </a>
      <a href="/" class="px-5 py-3.5 rounded-md border border-brand-cream-dark text-brand-brown-light font-medium hover:bg-brand-cream">
        Back home
      </a>
    </div>
  </div>
</PublicLayout>
