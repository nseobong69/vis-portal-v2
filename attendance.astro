---
// Staff/Teacher Portal, part 1 (Attendance slice) — replaces the Phase 2
// placeholder query (a flat `attendance_records` dump proving the route
// + auth pattern) with a real migration of renderAttendance()'s
// academic-context card + loadWeekPanel()/createWeek() flow.
//
// Ported this pass: the subject_teacher lock-out, prefs auto-load
// (teacher_attendance_prefs), the teacher's single assigned-class
// shortcut (teacher_classes → hides the class picker, same as old
// app's `showCls`), and the week panel with "Start Week N".
//
// NOT ported yet, and deliberately so — a separate, later continuation
// (see AttendanceContext.tsx's footer note in the UI itself): the
// actual day-by-day marking sheet (loadWeekView + the present/absent
// grid), closing a week, PDF export (jsPDF), and Excel export
// (SheetJS). Those are meaningfully larger than the context/week-panel
// shell this pass gets working, and per the Redesign Prompt's session
// pattern, each Feature Checklist row gets verified against the old
// app's exact output before being marked done — the marking sheet's
// business logic needs its own pass to do that justice.
import StaffLayout from '../../layouts/StaffLayout.astro';
import Card from '../../components/ui/Card';
import AttendanceContext from '../../components/staff/AttendanceContext';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';

const auth = await checkAuth(Astro.cookies, [
  'super_admin', 'admin', 'proprietor', 'head_teacher', 'principal',
  'teacher', 'subject_teacher',
]);

if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

const supabase = createServerSupabase(Astro.cookies);

// Ports renderAttendance()'s opening gate: a pure subject_teacher isn't
// assigned to mark class attendance at all (only a class teacher is).
// The old app's condition additionally allowed a subject_teacher who
// ALSO held the 'teacher' role through — this role model tracks one
// role per account, so that dual-role escape hatch has no equivalent
// here and a subject_teacher account is locked out unconditionally.
if (auth.role === 'subject_teacher') {
  return Astro.redirect('/403');
}

const [{ data: classes }, { data: prefsRows }] = await Promise.all([
  supabase.from('classes').select('id, name, arm').order('name'),
  supabase.from('teacher_attendance_prefs').select('*').eq('teacher_id', auth.userId).limit(1),
]);
const prefs = prefsRows?.[0] ?? null;

let assignedClassId: string | null = null;
if (auth.role === 'teacher') {
  const { data: tc } = await supabase
    .from('teacher_classes')
    .select('class_id')
    .eq('teacher_id', auth.userId)
    .limit(1);
  assignedClassId = tc?.[0]?.class_id ?? null;
}
// Same as old app's `showCls`: a class teacher with exactly one
// assigned class skips the picker; every other role picks explicitly.
const showClassPicker = auth.role !== 'teacher' || !assignedClassId;

let initialWeeks: any[] = [];
if (prefs) {
  const { data: weeks } = await supabase
    .from('attendance_week_logs')
    .select('*')
    .eq('session', prefs.session)
    .eq('term', prefs.term)
    .eq('class_id', prefs.class_id)
    .order('week_number');
  initialWeeks = weeks ?? [];
}
---
<StaffLayout title="Attendance" activePath="/staff/attendance">
  <Card>
    <AttendanceContext
      client:load
      classes={(classes ?? []).map((c: any) => ({ id: c.id, name: c.name, arm: c.arm ?? null }))}
      initialPrefs={prefs ? { session: prefs.session, term: prefs.term, class_id: prefs.class_id } : null}
      assignedClassId={assignedClassId}
      showClassPicker={showClassPicker}
      initialWeeks={initialWeeks}
    />
  </Card>
</StaffLayout>
