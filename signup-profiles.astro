---
// Replaces the earlier stub (a flat table showing only Name/Status, no
// detail, no way to actually approve/reject/create an account). Ported
// from renderSignUpProfiles() (index.html ~L29529-29556) and its
// approve/reject handlers (~L29590-29655).
//
// The three header buttons (Add Staff/Add Student/Add Parent) in the old
// app just reuse its existing account-creation modals
// (showSignUpProfileCreate(), ~L29656-29661) rather than being part of
// this feature themselves. Linked here to /admin/staff and
// /admin/students, which already have their own add-record UI per the
// existing nav. No confirmed /admin/parents page exists yet in this repo
// as far as I've seen — that link is included but may 404 until a
// parents management page is built; remove it if so.
import AdminLayout from '../../layouts/AdminLayout.astro';
import SignUpProfilesIsland from '../../components/admin/SignUpProfilesIsland';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';

// Mirrors canAccessAccountCreation() (index.html ~L18497).
const ALLOWED_ROLES = ['super_admin', 'admin', 'proprietor', 'head_teacher', 'principal'];
const auth = await checkAuth(Astro.cookies, ALLOWED_ROLES);
if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

const supabase = createServerSupabase(Astro.cookies);
const { data: reqs, error } = await supabase.from('signup_requests').select('*').order('submitted_at', { ascending: false }).limit(100);
const all = reqs || [];
const pending = all.filter((r) => r.status === 'pending');
const approved = all.filter((r) => r.status === 'approved');
const rejected = all.filter((r) => r.status === 'rejected');

// Same fallback SQL the old app itself shows inline when the table
// doesn't exist yet (index.html ~L29551-29553) — kept identical so
// whoever runs it gets the exact schema the rest of this feature expects.
const MISSING_TABLE_SQL = `create table if not exists signup_requests (id uuid default gen_random_uuid() primary key, full_name text, gender text, address text, email text, phone text, role text, extra_info text, status text default 'pending', submitted_at timestamptz default now(), reviewed_at timestamptz, reviewed_by text);`;
---
<AdminLayout title="Sign Up Profiles" activePath="/admin/signup-profiles" role={auth.role}>
  <div class="flex flex-col gap-4">
    <div class="flex justify-between items-start flex-wrap gap-3">
      <div>
        <h1 class="font-heading font-bold text-2xl text-brand-brown-dark">Sign Up Profiles</h1>
        <p class="text-sm text-brand-brown-light">Review and create accounts from sign-up requests.</p>
      </div>
      <div class="flex gap-2 flex-wrap">
        <a href="/admin/staff" class="bg-brand-brown text-white rounded-md px-3 py-2 text-sm font-medium">+ Add Staff</a>
        <a href="/admin/students" class="border border-brand-cream-dark rounded-md px-3 py-2 text-sm font-medium text-brand-brown-dark">+ Add Student</a>
        <a href="/admin/parents" class="border border-brand-cream-dark rounded-md px-3 py-2 text-sm font-medium text-brand-brown-dark">+ Add Parent</a>
      </div>
    </div>

    {error && (
      <div class="bg-danger-700/10 border border-danger-700 text-danger-700 text-sm rounded-md p-4">
        <div>Could not load sign-up requests: {error.message}</div>
        <div class="mt-3 text-xs text-brand-brown-light">
          If the <code>signup_requests</code> table doesn't exist yet, run this in Supabase SQL Editor:
        </div>
        <pre class="mt-2 bg-brand-cream text-xs rounded-md p-3 overflow-x-auto">{MISSING_TABLE_SQL}</pre>
      </div>
    )}

    {!error && (
      <SignUpProfilesIsland
        client:load
        initialPending={pending as any}
        initialApproved={approved as any}
        initialRejected={rejected as any}
      />
    )}
  </div>
</AdminLayout>
