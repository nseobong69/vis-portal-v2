---
// Ports renderStudentAcademics(). Tabs are a `?tab=` query param instead
// of the old app's in-page JS tab switch (switchStudentAcadTab) — same
// real-URL reasoning as the Parent Portal's ChildSwitcher. Assignment
// submission is TEXT-ONLY in this pass: the old app's file upload
// (input#file-*, image/PDF) needs Cloudinary signed uploads (Section
// 2.2's "Image uploads" row, its own migration item) — submitting text
// without a file attachment is real and works today, attaching a file
// is flagged TODO rather than silently dropped.
import StudentLayout from '../../layouts/StudentLayout.astro';
import Card from '../../components/ui/Card';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';

const auth = await checkAuth(Astro.cookies, ['student']);
if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

const supabase = createServerSupabase(Astro.cookies);
const { data: student } = await supabase
  .from('students')
  .select('class_id')
  .eq('id', auth.userId)
  .single();

const tab = Astro.url.searchParams.get('tab') || 'assignments';
const submitted = Astro.url.searchParams.get('submitted') === '1';

let regSubjectIds = new Set<string>();
let assignments: { id: string; title: string; subject_name: string | null; content: string | null; submission_date: string | null }[] = [];
let notes: { id: string; title: string; subject_name: string | null; content: string | null }[] = [];
let videos: { id: string; title: string; subject_name: string | null; url: string | null }[] = [];
let mySubs: Record<string, { status: string; score: number | null }> = {};

if (student?.class_id) {
  const { data: regs } = await supabase
    .from('subject_registrations')
    .select('subject_id')
    .eq('student_id', auth.userId);
  regSubjectIds = new Set((regs ?? []).map((r) => r.subject_id));

  if (regSubjectIds.size) {
    const [a, n, v] = await Promise.all([
      supabase.from('academic_assignments').select('id, title, subject_name, subject_id, content, submission_date').eq('class_id', student.class_id),
      supabase.from('academic_notes').select('id, title, subject_name, subject_id, content').eq('class_id', student.class_id),
      supabase.from('academic_videos').select('id, title, subject_name, subject_id, url').eq('class_id', student.class_id),
    ]);
    const inReg = (i: { subject_id?: string | null }) => !i.subject_id || regSubjectIds.has(i.subject_id);
    assignments = (a.data ?? []).filter(inReg);
    notes = (n.data ?? []).filter(inReg);
    videos = (v.data ?? []).filter(inReg);

    if (assignments.length) {
      const { data: subs } = await supabase
        .from('assignment_submissions')
        .select('assignment_id, status, score')
        .eq('student_id', auth.userId)
        .in('assignment_id', assignments.map((x) => x.id));
      (subs ?? []).forEach((s) => { mySubs[s.assignment_id] = { status: s.status, score: s.score }; });
    }
  }
}
---
<StudentLayout title="Academics" activePath="/student/academics">
  {!student?.class_id ? (
    <Card><p class="text-center text-danger-700 py-8">You are not assigned to a class. Contact admin to assign your class.</p></Card>
  ) : !regSubjectIds.size ? (
    <Card className="max-w-[520px]">
      <p class="text-brand-brown-light mb-3">You have not registered for any subjects this term. Please register your subjects first.</p>
      <a href="/student/subject-registration" class="inline-block px-4 py-2 rounded-md bg-brand-brown text-white text-sm font-medium">Register Subjects</a>
    </Card>
  ) : (
    <>
      {submitted && <p class="text-success-700 text-sm mb-3">✅ Submission received.</p>}
      <div class="flex gap-1 bg-brand-cream rounded-full p-1 mb-5 max-w-[520px]">
        {[
          { key: 'assignments', label: `Assignments (${assignments.length})` },
          { key: 'notes', label: `Notes (${notes.length})` },
          { key: 'videos', label: `Videos (${videos.length})` },
        ].map((t) => (
          <a
            href={`/student/academics?tab=${t.key}`}
            class:list={['flex-1 text-center px-3 py-1.5 rounded-full text-xs font-semibold', tab === t.key ? 'bg-brand-brown text-white' : 'text-brand-brown-light']}
          >
            {t.label}
          </a>
        ))}
      </div>

      {tab === 'assignments' && (
        <div class="flex flex-col gap-4">
          {!assignments.length && <Card><p class="text-center text-brand-brown-light py-8">No assignment available. Check back later.</p></Card>}
          {assignments.map((a) => {
            const sub = mySubs[a.id];
            return (
              <Card>
                <div class="flex justify-between items-start gap-3 flex-wrap mb-2">
                  <div>
                    <div class="font-bold text-brand-brown">{a.title}</div>
                    <div class="text-xs text-brand-brown-light mt-1">{a.subject_name || '—'}</div>
                  </div>
                  {a.submission_date && <div class="text-xs text-danger-700 font-semibold">Due: {new Date(a.submission_date).toLocaleDateString()}</div>}
                </div>
                <p class="text-sm whitespace-pre-wrap">{a.content}</p>
                {sub ? (
                  <div class:list={['mt-3 p-3 rounded-md text-sm', sub.status === 'graded' ? 'bg-success-soft text-success-700' : 'bg-warning-soft text-warning-700']}>
                    {sub.status === 'graded' ? `Graded — Score: ${sub.score}` : 'Submitted — awaiting grade'}
                  </div>
                ) : (
                  <form method="POST" action="/api/student/academics/submit" class="mt-3 flex flex-col gap-2">
                    <input type="hidden" name="assignment_id" value={a.id} />
                    <textarea name="answer" rows={3} class="w-full border border-brand-cream-dark rounded-md px-3 py-2 text-sm" placeholder="Type your answer here…"></textarea>
                    <button type="submit" class="self-start px-3 py-1.5 rounded-md bg-brand-brown text-white text-sm font-medium">Submit</button>
                    <p class="text-xs text-brand-brown-light">File attachments (image/PDF) not yet available — text answer only.</p>
                  </form>
                )}
              </Card>
            );
          })}
        </div>
      )}

      {tab === 'notes' && (
        <div class="flex flex-col gap-4">
          {!notes.length && <Card><p class="text-center text-brand-brown-light py-8">No notes posted yet.</p></Card>}
          {notes.map((n) => (
            <Card title={n.title}>
              <div class="text-xs text-brand-brown-light mb-2">{n.subject_name || '—'}</div>
              <p class="text-sm whitespace-pre-wrap">{n.content}</p>
            </Card>
          ))}
        </div>
      )}

      {tab === 'videos' && (
        <div class="grid gap-4" style="grid-template-columns:repeat(auto-fill,minmax(240px,1fr));">
          {!videos.length && <Card><p class="text-center text-brand-brown-light py-8">No videos posted yet.</p></Card>}
          {videos.map((v) => (
            <Card title={v.title}>
              <div class="text-xs text-brand-brown-light mb-2">{v.subject_name || '—'}</div>
              {v.url ? <a href={v.url} class="text-sm text-brand-brown underline">Watch video</a> : <p class="text-sm text-brand-brown-light">No link available.</p>}
            </Card>
          ))}
        </div>
      )}
    </>
  )}
</StudentLayout>
