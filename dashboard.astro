---
// Ports renderStudentDash(). Not ported in this pass: the live fee-status
// check's 3-way color logic (Cleared/Partial/Pending across possibly
// multiple invoices for the current session) and the exam-access-codes
// card (cbt_student_codes — belongs with the full CBT exam-taking engine,
// see /student/exams for that scope note). This shows the same
// underlying signal — fee balance, class, notices, quick links — with
// today's simpler paid/unpaid split, matching how Parent Dashboard
// already summarizes fee balance.
import StudentLayout from '../../layouts/StudentLayout.astro';
import Card from '../../components/ui/Card';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';

const auth = await checkAuth(Astro.cookies, ['student']);
if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

const supabase = createServerSupabase(Astro.cookies);
const { data: student } = await supabase
  .from('students')
  .select('full_name, class_name, admission_number')
  .eq('id', auth.userId)
  .single();

const { data: fees } = await supabase
  .from('fee_payments')
  .select('amount, status')
  .eq('student_id', auth.userId);
const { data: notices } = await supabase
  .from('announcements')
  .select('title, created_at')
  .order('created_at', { ascending: false })
  .limit(5);

const balance = (fees ?? []).reduce((s, f) => s + (f.status === 'paid' ? 0 : f.amount || 0), 0);
---
<StudentLayout title="Student Dashboard" activePath="/student/dashboard">
  <div class="rounded-[18px] p-6 mb-5 text-white" style="background:linear-gradient(135deg,#5D4037,#8D6E63);">
    <div class="text-lg font-bold">{student?.full_name || '—'}</div>
    <div class="text-xs opacity-80 mt-1">Admission: {student?.admission_number || '—'} &middot; Class: {student?.class_name || '—'}</div>
  </div>

  <div class="grid gap-4 mb-5" style="grid-template-columns:repeat(auto-fit,minmax(170px,1fr));">
    <Card><div class="text-xs text-brand-brown-light mb-1">My Class</div><div class="text-xl font-bold">{student?.class_name || '—'}</div></Card>
    <Card>
      <div class="text-xs text-brand-brown-light mb-1">Fee Status</div>
      <div class:list={['text-xl font-bold', balance ? 'text-danger-700' : 'text-success-700']}>
        {balance ? `₦${balance.toLocaleString()} due` : 'Cleared'}
      </div>
    </Card>
  </div>

  <div class="grid gap-4" style="grid-template-columns:1fr 1fr;">
    <Card title="Quick Access">
      <div class="flex flex-col gap-2">
        <a href="/student/results" class="px-4 py-2 rounded-md bg-brand-brown text-white text-sm font-medium text-center">My Results</a>
        <a href="/student/academics" class="px-4 py-2 rounded-md border border-brand-cream-dark text-sm font-medium text-center">Academics</a>
        <a href="/student/exams" class="px-4 py-2 rounded-md border border-brand-cream-dark text-sm font-medium text-center">Take Exam</a>
        <a href="/student/fees" class="px-4 py-2 rounded-md border border-brand-cream-dark text-sm font-medium text-center">Pay Fees</a>
      </div>
    </Card>
    <Card title="Notice Board">
      {notices?.length ? (
        <div class="flex flex-col gap-2">
          {notices.map((n: { title: string; created_at: string }) => (
            <div class="text-sm text-brand-brown-light border-b border-brand-cream-dark pb-2">📢 {n.title}</div>
          ))}
        </div>
      ) : (
        <p class="text-sm text-brand-brown-light">No notices.</p>
      )}
    </Card>
  </div>
</StudentLayout>
