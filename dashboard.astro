---
// Staff/Teacher Portal, part 1 — ports renderTeacherDash()/
// renderSubjectTeacherDash() as one real page with two variants keyed
// off `auth.role`, per Section 4 Phase 4 grouping 2 ("Teaching staff
// ... their dashboard should foreground today's classes and pending
// attendance/results entry, not a full admin menu").
//
// Real this pass: My Classes / My Subjects counts (teacher_classes /
// teacher_subjects), and the Attendance quick action (a real route).
// NOT real yet, shown as disabled: Enter Scores, Manage CBT, Score
// Sheet, Announcements, Attendance Report — those screens haven't
// been migrated yet, so linking them would be a dead or fake link;
// disabled + labelled "Coming soon" instead of silently omitted, so
// the checklist gap stays visible rather than hidden.
import StaffLayout from '../../layouts/StaffLayout.astro';
import Card from '../../components/ui/Card';
import { checkAuth } from '../../lib/auth';
import { createServerSupabase } from '../../lib/supabase';

const auth = await checkAuth(Astro.cookies, ['teacher', 'subject_teacher']);
if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

const supabase = createServerSupabase(Astro.cookies);
const isSubjectTeacher = auth.role === 'subject_teacher';

const { count: classCount } = await supabase
  .from('teacher_classes')
  .select('id', { count: 'exact', head: true })
  .eq('teacher_id', auth.userId);

const { count: subjectCount } = await supabase
  .from('teacher_subjects')
  .select('id', { count: 'exact', head: true })
  .eq('teacher_id', auth.userId);

const quickActions = [
  { label: 'Enter Scores', href: null, icon: '📝' },
  isSubjectTeacher
    ? { label: 'Score Sheet', href: null, icon: '📄' }
    : { label: 'Mark Attendance', href: '/staff/attendance', icon: '✅' },
  { label: isSubjectTeacher ? 'My CBT Exams' : 'Manage CBT', href: null, icon: '💻' },
  { label: isSubjectTeacher ? 'Announcements' : 'Attendance Report', href: null, icon: isSubjectTeacher ? '📢' : '📊' },
];
---
<StaffLayout title="Dashboard" activePath="/staff/dashboard">
  <div class="grid gap-4 mb-5" style="grid-template-columns:repeat(auto-fit,minmax(190px,1fr));">
    <Card>
      <div class="text-xs text-brand-brown-light mb-1">{isSubjectTeacher ? 'My Subjects' : 'My Classes'}</div>
      <div class="text-xl font-bold text-brand-brown-dark">{isSubjectTeacher ? (subjectCount ?? 0) : (classCount ?? 0)}</div>
    </Card>
    <Card>
      <div class="text-xs text-brand-brown-light mb-1">{isSubjectTeacher ? 'CBT Exams' : 'Results Pending'}</div>
      <div class="text-xl font-bold text-brand-brown-dark">—</div>
    </Card>
  </div>

  <Card title="Quick Actions">
    <div class="flex flex-col gap-2 max-w-sm">
      {quickActions.map((a) =>
        a.href ? (
          <a
            href={a.href}
            class="px-4 py-2 rounded-md bg-brand-brown text-white text-sm font-medium text-center"
          >
            {a.icon} {a.label}
          </a>
        ) : (
          <button
            type="button"
            disabled
            title="Not migrated to the new portal yet"
            class="px-4 py-2 rounded-md border border-brand-cream-dark text-sm font-medium text-center text-brand-brown-light cursor-not-allowed opacity-60"
          >
            {a.icon} {a.label} <span class="text-[10px] uppercase tracking-wide">(soon)</span>
          </button>
        )
      )}
    </div>
  </Card>
</StaffLayout>
