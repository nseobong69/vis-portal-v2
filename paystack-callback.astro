---
export const prerender = false;
const reference = Astro.url.searchParams.get('reference') || Astro.url.searchParams.get('trxref') || '';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Confirming payment…</title>
  <style>
    body { font-family: system-ui, sans-serif; background: #F0FDF4; display: flex; align-items: center;
      justify-content: center; min-height: 100vh; margin: 0; padding: 20px; }
    .card { background: #fff; border-radius: 16px; padding: 40px 32px; text-align: center; max-width: 400px;
      box-shadow: 0 8px 32px rgba(0,0,0,.08); }
    .title { font-size: 18px; font-weight: 700; margin-bottom: 8px; }
    .sub { font-size: 14px; color: #6B7280; line-height: 1.6; }
    .ok { color: #059669; } .err { color: #B91C1C; }
  </style>
</head>
<body>
  <div class="card">
    <div id="msg" class="title">Confirming your payment…</div>
    <div id="sub" class="sub">Please wait, do not close this tab.</div>
  </div>
  <script define:vars={{ reference }}>
    (async () => {
      const msgEl = document.getElementById('msg');
      const subEl = document.getElementById('sub');
      if (!reference) {
        msgEl.textContent = 'Missing payment reference.';
        msgEl.className = 'title err';
        return;
      }
      try {
        const res = await fetch('/api/admissions/paystack-verify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reference }),
        });
        const json = await res.json();
        if (res.ok && json.success) {
          msgEl.textContent = 'Payment confirmed ✅';
          msgEl.className = 'title ok';
          subEl.textContent = 'You can close this tab and return to the form.';
          if (window.opener) {
            window.opener.postMessage(
              { type: 'admission-paystack-verified', success: true, reference: json.reference, amount: json.amount_naira },
              window.location.origin,
            );
          }
          setTimeout(() => { try { window.close(); } catch {} }, 2500);
        } else {
          msgEl.textContent = 'Payment could not be confirmed.';
          msgEl.className = 'title err';
          subEl.textContent = json.error || 'Please return to the form and try again, or choose bank transfer / cash.';
          if (window.opener) {
            window.opener.postMessage({ type: 'admission-paystack-verified', success: false }, window.location.origin);
          }
        }
      } catch (e) {
        msgEl.textContent = 'Something went wrong.';
        msgEl.className = 'title err';
        subEl.textContent = 'Please return to the form and try again.';
      }
    })();
  </script>
</body>
</html>
