---
// Real route at /academics-overview (old app used /academics as a
// pushState-only URL for a JS modal — showAcademicsPage()). Named
// "-overview" here per Phase 0's suggestion, to leave /academics free
// for a possible future deeper academics section.
import PublicLayout from '../layouts/PublicLayout.astro';
import InfoRow from '../components/InfoRow.astro';

const levels = [
  { icon: '🧸', title: 'Crèche & Nursery',
    body: 'Our Early Years programme provides a safe, stimulating environment where little ones build foundational language, numeracy, and social skills through play-based learning.' },
  { icon: '✏️', title: 'Primary (Pry 1 – 6)',
    body: 'A structured, engaging curriculum covering English, Mathematics, Basic Science, Social Studies, Cultural & Creative Arts, and more — aligned with the Nigerian national curriculum.' },
  { icon: '📐', title: 'Junior Secondary (JSS 1 – 3)',
    body: 'Students deepen knowledge across core subjects, begin STEM specialisation, and develop critical thinking skills to prepare for the BECE and senior school transition.' },
  { icon: '🎓', title: 'Senior Secondary (SSS 1 – 3)',
    body: 'Science, Arts and Commercial tracks allow students to focus on their strengths and career aspirations, preparing thoroughly for WAEC, NECO, JAMB and beyond.' },
];

const strengths = [
  'Strong pass rates in WAEC & NECO examinations',
  'CBT-based entrance assessments for fair placement',
  'Regular inter-school academic competitions',
  'Dedicated STEM lab and digital learning resources',
  'Small class sizes for personalised attention',
];
---
<PublicLayout title="Academics" description="Academic programme at Victorious International Schools.">
  <div class="max-w-[680px] mx-auto px-5 py-12">
    <h1 class="font-heading font-extrabold text-3xl text-brand-brown-dark mb-3">World-Class Learning</h1>
    <p class="text-brand-brown-light leading-relaxed mb-8">
      At Victorious International Schools, our academic programme cultivates critical
      thinking, creativity and a lifelong love of learning — from Crèche right through
      to Senior Secondary School. Every learner gets the attention, resources and
      encouragement they need to thrive.
    </p>

    <h2 class="font-heading font-bold text-xs uppercase tracking-wide text-brand-brown mb-2">
      School Levels
    </h2>
    <div class="border border-brand-cream-dark rounded-lg px-4 mb-6">
      {levels.map((l) => <InfoRow icon={l.icon} title={l.title} body={l.body} />)}
    </div>

    <div class="bg-brand-cream rounded-lg px-5 py-4">
      <div class="font-heading font-bold text-sm text-brand-brown mb-2">🏆 Our Academic Strengths</div>
      <ul class="list-disc pl-5 text-sm text-brand-brown-light space-y-1.5">
        {strengths.map((s) => <li>{s}</li>)}
      </ul>
    </div>

    <div class="flex gap-3 mt-8 flex-wrap">
      <a href="/admissions" class="flex-1 min-w-[180px] text-center bg-brand-brown text-white font-semibold py-3.5 rounded-md hover:bg-brand-brown-dark">
        Admissions →
      </a>
      <a href="/" class="px-5 py-3.5 rounded-md border border-brand-cream-dark text-brand-brown-light font-medium hover:bg-brand-cream">
        Back home
      </a>
    </div>
  </div>
</PublicLayout>
