---
// Real route at /student/exams/[id] — the "Start Exam" destination from
// the listing page (../exams.astro). Server-side re-validates the same
// visibility rules as the listing (class/date-window/allowed-students/
// already-submitted) before rendering anything, since a direct hit here
// must be just as safe as clicking through from the list (Section 3).
import StudentLayout from '../../../layouts/StudentLayout.astro';
import Card from '../../../components/ui/Card';
import ExamRunner from '../../../components/student/ExamRunner';
import { checkAuth } from '../../../lib/auth';
import { createServerSupabase } from '../../../lib/supabase';

const auth = await checkAuth(Astro.cookies, ['student']);
if (auth.status === 'unauthenticated') {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
if (auth.status === 'unauthorized') {
  return Astro.redirect('/403');
}

const examId = Astro.params.id!;
const supabase = createServerSupabase(Astro.cookies);

const { data: student } = await supabase.from('students').select('class_id, avatar_url').eq('id', auth.userId).single();
const { data: exam } = await supabase
  .from('cbt_exams')
  .select('id, title, duration_minutes, class_id, status, start_at, end_at, allowed_students, access_code')
  .eq('id', examId)
  .single();

let denyReason: string | null = null;
if (!exam) denyReason = 'Exam not found.';
else if (exam.status !== 'active') denyReason = 'This exam is not currently active.';
else if (exam.class_id !== student?.class_id) denyReason = 'This exam is not available to your class.';
else if (exam.start_at && new Date(exam.start_at) > new Date()) denyReason = 'This exam has not opened yet.';
else if (exam.end_at && new Date(exam.end_at) < new Date()) denyReason = 'This exam has closed.';
else if (exam.allowed_students?.length && !exam.allowed_students.includes(auth.userId)) denyReason = 'This exam is not available to your account.';

let alreadySubmitted = false;
if (!denyReason) {
  const { data: existing } = await supabase
    .from('cbt_submissions')
    .select('id')
    .eq('exam_id', examId)
    .eq('student_id', auth.userId)
    .maybeSingle();
  alreadySubmitted = !!existing;
}

let requiresCode = false;
if (!denyReason && !alreadySubmitted) {
  const { data: studentCode } = await supabase
    .from('cbt_student_codes')
    .select('id')
    .eq('exam_id', examId)
    .eq('student_id', auth.userId)
    .eq('status', 'active')
    .maybeSingle();
  requiresCode = !!studentCode || !!exam?.access_code;
}
---
<StudentLayout title={exam?.title || 'Exam'} activePath="/student/exams">
  {denyReason ? (
    <Card><p class="text-center text-danger-700 py-8">{denyReason}</p></Card>
  ) : alreadySubmitted ? (
    <Card>
      <p class="text-center text-brand-brown-light py-8">You have already submitted this exam. No retakes.</p>
    </Card>
  ) : (
    <ExamRunner
      client:load
      exam={{ id: exam!.id, title: exam!.title, duration_minutes: exam!.duration_minutes ?? undefined }}
      requiresCode={requiresCode}
      profileImageUrl={student?.avatar_url ?? null}
    />
  )}
</StudentLayout>
